#!/usr/bin/env php
<?php

declare(strict_types=1);

// Widdx CLI tool: php widdx new <project-name>

define('WIDDX_BASE_PATH', __DIR__);

$autoload = __DIR__ . '/vendor/autoload.php';
if (is_file($autoload)) {
    require $autoload;
} else {
    spl_autoload_register(function ($class) {
        foreach (['Widdx\\' => __DIR__ . '/core/', 'App\\' => __DIR__ . '/app/', 'Psr\\' => __DIR__ . '/polyfill/'] as $prefix => $dir) {
            if (str_starts_with($class, $prefix)) {
                $file = $dir . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
                if (is_file($file)) {
                    require $file;
                }
            }
        }
    });
    require __DIR__ . '/core/helpers.php';
}

$argv = $_SERVER['argv'];
array_shift($argv);
$command = $argv[0] ?? 'help';

