<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(composer\.json|\.env|database\.sqlite|widdx)$">
    Require all denied
</FilesMatch>

<Files .env>
    Require all denied
</Files>
HTACCESS);

    // public/.htaccess
    write_file("{$base}/public/.htaccess", <<<'HTACCESS'
<IfModule mod_rewrite.c>
