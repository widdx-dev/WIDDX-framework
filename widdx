function create_project(string $name, bool $isApi = false): void
{
    // Accept both relative ("myapp") and absolute ("/tmp/myapp") names.
    $absolute = preg_match('#^(/|[a-zA-Z]:[\\\\/])#', $name) === 1;
    $base = $absolute ? rtrim($name, '/') : getcwd() . '/' . $name;
    if (is_dir($base)) {
        fwrite(STDERR, "Directory already exists: {$base}\n");
        exit(1);
    }

    echo "Creating Widdx project: {$name}\n\n";

    // Create directory structure
    $dirs = [
        'app/Controllers', 'app/Models', 'app/Middleware',
        'config', 'database/migrations', 'database/seeders',
        'routes', 'views', 'views/errors', 'views/layouts',
        'lang', 'public', 'storage', 'storage/logs', 'storage/cache',
        'storage/sessions',
    ];
    foreach ($dirs as $dir) {
        mkdir("{$base}/{$dir}", 0775, true);
    }

    // Copy core framework
    $coreSource = WIDDX_BASE_PATH . '/core';
    $coreDest = "{$base}/core";
    recursive_copy($coreSource, $coreDest);

    // Copy PSR polyfill (used by the no-Composer fallback autoloader)
    if (is_dir(WIDDX_BASE_PATH . '/polyfill')) {
        recursive_copy(WIDDX_BASE_PATH . '/polyfill', "{$base}/polyfill");
    }

    // Copy framework language files (validation messages etc.)
    if (is_dir(WIDDX_BASE_PATH . '/lang')) {
        recursive_copy(WIDDX_BASE_PATH . '/lang', "{$base}/lang");
    }

    // Copy widdx CLI
    copy(WIDDX_BASE_PATH . '/widdx', "{$base}/widdx");
    chmod("{$base}/widdx", 0755);

    // Copy test runner when present (so 'php widdx test' works in the new project)
    if (is_file(WIDDX_BASE_PATH . '/widdx-test')) {
        copy(WIDDX_BASE_PATH . '/widdx-test', "{$base}/widdx-test");
        chmod("{$base}/widdx-test", 0755);
        if (is_dir(WIDDX_BASE_PATH . '/tests')) {
            // tmp-debug holds throwaway app trees from debugging runs.
            recursive_copy(WIDDX_BASE_PATH . '/tests', "{$base}/tests", ['tmp-debug']);
