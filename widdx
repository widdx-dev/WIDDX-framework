function recursive_copy(string $src, string $dst, array $skip = []): void
{
    $dir = opendir($src);
    @mkdir($dst, 0775, true);
    while (($file = readdir($dir)) !== false) {
        if ($file === '.' || $file === '..' || in_array($file, $skip, true)) continue;
        if (is_dir("{$src}/{$file}")) {
            recursive_copy("{$src}/{$file}", "{$dst}/{$file}", $skip);
        } else {
            copy("{$src}/{$file}", "{$dst}/{$file}");
        }
    }
    closedir($dir);
}

// ---------- Resource Route Helpers ----------

function make_resource_routes(string $name, string $controller): void
{
    $studly = studly($name);
    $controllerClass = "App\\Controllers\\{$studly}Controller";

    get("/{$name}", [$controllerClass, 'index'])->name("{$name}.index");
    get("/{$name}/create", [$controllerClass, 'create'])->name("{$name}.create");
    post("/{$name}", [$controllerClass, 'store'])->name("{$name}.store");
    get("/{$name}/{id}", [$controllerClass, 'show'])->name("{$name}.show");
    get("/{$name}/{id}/edit", [$controllerClass, 'edit'])->name("{$name}.edit");
    put("/{$name}/{id}", [$controllerClass, 'update'])->name("{$name}.update");
    delete("/{$name}/{id}", [$controllerClass, 'destroy'])->name("{$name}.destroy");
}

function make_api_resource_routes(string $name, string $controller): void
{
    $studly = studly($name);
    $controllerClass = "App\\Controllers\\{$studly}Controller";

    get("/api/{$name}", [$controllerClass, 'index'])->name("api.{$name}.index");
    post("/api/{$name}", [$controllerClass, 'store'])->name("api.{$name}.store");
    get("/api/{$name}/{id}", [$controllerClass, 'show'])->name("api.{$name}.show");
    put("/api/{$name}/{id}", [$controllerClass, 'update'])->name("api.{$name}.update");
    delete("/api/{$name}/{id}", [$controllerClass, 'destroy'])->name("api.{$name}.destroy");
}

