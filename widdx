function studly(string $name): string
{
    $name = str_replace(['-', '_'], ' ', trim($name));
    $name = str_replace(' ', '', ucwords($name));
    return $name;
}

function write_file(string $path, string $content): void
{
    $dir = dirname($path);
    if (!is_dir($dir)) {
        mkdir($dir, 0775, true);
    }
    if (is_file($path)) {
        fwrite(STDERR, "File already exists, skipping: {$path}\n");
        exit(1);
    }
    // A heredoc drops the final newline, and an "add one route line" append then
    // glues itself onto the last comment — a parse error waiting to happen.
    if (!str_ends_with($content, "\n")) {
        $content .= "\n";
    }
    file_put_contents($path, $content);
    echo "  Created: {$path}\n";
}

