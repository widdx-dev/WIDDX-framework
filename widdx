        'type' => 'project',
        'license' => 'MIT',
        'require' => ['php' => '>=8.1', 'psr/container' => '^2.0'],
        'autoload' => [
            'psr-4' => ['Widdx\\' => 'core/', 'App\\' => 'app/'],
            'files' => ['core/helpers.php'],
