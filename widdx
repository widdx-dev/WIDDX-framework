                ? (is_object($r->action[0]) ? get_class($r->action[0]) : $r->action[0]) . '@' . $r->action[1]
                : (is_string($r->action) ? $r->action : 'Closure');
            printf("%-22s %-28s %s\n", implode('|', $r->methods), $r->uri, $action);
        }
        break;
    }

    case 'serve': {
        $port = 8000;
        $host = 'localhost';
        foreach ($argv as $a) {
            if (str_starts_with($a, '--port=')) {
                $port = (int) substr($a, 7);
            } elseif (str_starts_with($a, '--host=')) {
                $host = substr($a, 7);
            }
        }
        // Some images (e.g. php:cli) ship with an empty session.save_path,
        // which silently breaks sessions. Self-heal to storage/sessions.
        $iniSavePath = (string) ini_get('session.save_path');
        $phpOpts = '';
        if ($iniSavePath === '' || !is_dir($iniSavePath)) {
            $sessions = WIDDX_BASE_PATH . '/storage/sessions';
            if (!is_dir($sessions)) {
                @mkdir($sessions, 0775, true);
            }
            if (is_dir($sessions) && is_writable($sessions)) {
                $phpOpts = ' -d session.save_path=' . escapeshellarg($sessions);
            }
        }
        echo "Widdx running at http://{$host}:{$port}\n";
        // router.php passes real files (install.php, assets) straight through
        // and sends everything else to the framework — without it the dev
        // server 404s URIs like /storage/img/photo.jpg that have no physical
        // counterpart inside public/.
        $router = WIDDX_BASE_PATH . '/public/router.php';
        if (!is_file($router)) {
            $router = WIDDX_BASE_PATH . '/public/index.php';
        }
        passthru(PHP_BINARY . $phpOpts . " -S " . escapeshellarg($host) . ":{$port} -t " . escapeshellarg(WIDDX_BASE_PATH . '/public') . ' ' . escapeshellarg($router));
        break;
    }

    case 'test': {
        $testCode = 0;
        passthru(PHP_BINARY . " " . escapeshellarg(__DIR__ . '/widdx-test'), $testCode);
        exit($testCode);
    }

    case 'queue:work': {
        $queue = 'default';
        $max = 0;
        foreach ($argv as $a) {
            if (str_starts_with($a, '--queue=')) {
                $queue = substr($a, 8);
            }
            if (str_starts_with($a, '--max=')) {
                $max = (int) substr($a, 6);
            }
        }
        $processed = \Widdx\Queue::work($queue, $max);
        echo "Processed {$processed} job(s).\n";
        break;
    }

    case 'queue:push': {
        $class = $argv[1] ?? '';
        if ($class === '') {
            fwrite(STDERR, "Usage: php widdx queue:push App\\Jobs\\MyJob '{\"key\":\"value\"}'\n");
            exit(1);
        }
        if (!class_exists($class)) {
            fwrite(STDERR, "Job class [{$class}] not found.\n");
            exit(1);
        }
        $data = json_decode((string) ($argv[2] ?? '{}'), true) ?: [];
        $id = \Widdx\Queue::push($class, $data);
        echo "Pushed job #{$id}\n";
        break;
    }

    case 'queue:failed': {
        $conn = \Widdx\Queue::connection();
        if (!$conn instanceof \Widdx\DatabaseQueue) {
            fwrite(STDERR, "queue:failed needs the 'database' queue driver (QUEUE_DRIVER=database in .env)\n");
            exit(1);
        }
        $rows = $conn->failedJobs();
        if ($rows === []) {
            echo "No failed jobs.\n";
            break;
        }
        foreach ($rows as $row) {
            $p = json_decode((string) $row['payload'], true) ?: [];
            echo "#{$row['id']} [{$row['queue']}] " . ($p['job'] ?? '?') . " — {$row['reason']} @ {$row['failed_at']}\n";
        }
        break;
    }

    case 'queue:retry': {
        $target = $argv[1] ?? '';
        $conn = \Widdx\Queue::connection();
        if (!$conn instanceof \Widdx\DatabaseQueue) {
            fwrite(STDERR, "queue:retry needs the 'database' queue driver (QUEUE_DRIVER=database in .env)\n");
            exit(1);
        }
        if ($target === 'all' || $target === '*') {
            $ids = array_map(fn($r) => (int) $r['id'], $conn->failedJobs());
        } elseif (ctype_digit($target)) {
            $ids = [(int) $target];
        } else {
            fwrite(STDERR, "Usage: php widdx queue:retry <id>|all\n");
            exit(1);
        }
        $n = 0;
        foreach ($ids as $id) {
            if ($conn->retryFailed($id)) {
                $n++;
            }
        }
        echo "Re-queued {$n} job(s).\n";
        break;
    }

    case 'schedule:run': {
        $ran = \Widdx\Schedule::run(WIDDX_BASE_PATH, false);
        echo $ran === [] ? "Nothing due.\n" : 'Ran ' . count($ran) . " scheduled task(s).\n";
        break;
    }

    case 'help':
    case '--help':
    case '-h':
    default:
        if ($command !== 'help' && !in_array($command, ['--help', '-h'], true)) {
            fwrite(STDERR, "Unknown command: {$command}\n\n");
        }
        widdx_help();
        break;
}
