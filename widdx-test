    $section = substr($api, $start);

    $sources = [
        'Global helpers' => 'function',
        'Model statics' => \Widdx\Model::class,
        'Model instance methods' => \Widdx\Model::class,
        'QueryBuilder' => \Widdx\QueryBuilder::class,
