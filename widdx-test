test('2.12 the measured doc facts stay written down and the dead ones stay out', function () {
    $root = __DIR__;
    if (!str_starts_with(rtrim((string) @file_get_contents($root . '/README.md')), '# Widdx')) {
        return; // scaffolded project
    }
    $docs = [
        'AGENTS.md' => (string) file_get_contents($root . '/AGENTS.md'),
        'README.md' => (string) file_get_contents($root . '/README.md'),
        'llms.txt' => (string) file_get_contents($root . '/llms.txt'),
        'routes/web.php' => (string) file_get_contents($root . '/routes/web.php'),
        'core/Cli/MakeCrud.php' => (string) file_get_contents($root . '/core/Cli/MakeCrud.php'),
    ];
    // Sentences measured as FALSE and removed on 2026-10-15. If one reappears, the person
    // adding it has not run the probe — this is the whole reason the test exists.
    $forbidden = [
        'restart nothing',                     // `php widdx serve` does NOT hot-reload
        'picks it up on the next request',     // the same false promise, older wording
        'uncomment to enable globally',        // CSRF is already on through the ambient web group
    ];
    foreach ($docs as $name => $body) {
        foreach ($forbidden as $phrase) {
            assert_true(
                stripos($body, $phrase) === false,
                "{$name} revived a claim measured false: \"{$phrase}\""
            );
        }
    }
    // The corrections themselves must not silently vanish.
    $required = [
        'AGENTS.md' => ['is NOT reliably seen', 'Restart is the whole fix',
                        'CSRF + security headers are already ON', 'that line makes it run twice',
                        'is named `csrf_token`', 'fills them by itself'],
        'README.md' => ['if it was already running, restart it', 'that runs the middleware twice',
                        'unpublished on Packagist'],
        'core/Cli/MakeCrud.php' => ['restart is required'],
        'routes/web.php' => ['ALREADY on'],
    ];
    foreach ($required as $name => $phrases) {
        foreach ($phrases as $phrase) {
            assert_true(str_contains($docs[$name], $phrase), "{$name} must keep: \"{$phrase}\"");
        }
    }
    // PART 0 is the recipe small models execute verbatim: every command in it must be a real
    // CLI verb, and the restart step must be inside the recipe, not only in the prose.
    $part0 = (string) preg_replace('/^.*## PART 0.*$/m', '', file_get_contents($root . '/AGENTS.md'));
    $part0 = substr($part0, 0, (int) strpos($part0, '## PART 1'));
    preg_match_all('/^\s*php widdx ([a-z:]+)\b/m', $part0, $m);
    $verbs = array_unique($m[1]);
    assert_true(count($verbs) >= 3, 'PART 0 lost its commands: ' . implode(',', $verbs));
    $cli = (string) file_get_contents($root . '/widdx');
    foreach ($verbs as $verb) {
        assert_true(str_contains($cli, "case '{$verb}'"), "PART 0 documents `php widdx {$verb}`, which the CLI does not implement");
    }
    assert_true(str_contains($part0, 'php widdx serve') && str_contains($part0, 'restart'),
        'PART 0 must tell the reader to restart the dev server — it is the step an agent skips otherwise');
});

