test('DatabaseQueue: retry with backoff, then failed_jobs, then queue:retry', function () {
    $q = new \Widdx\DatabaseQueue();
    $pdo = \Widdx\Database::connection()->pdo();
    $pdo->exec('DELETE FROM jobs');
    $pdo->exec('DELETE FROM failed_jobs');

    $q->push(\Widdx\Tests\FailingJob::class, ['n' => 1]);
    $row = $q->pop();
    assert_true($row !== null);
    assert_equals(1, (int) $row['attempts'], 'pop reports the NEW attempt number');
    assert_equals(2, (int) $row['payload']['tries'], 'job $tries embedded at push time');
    $q->failed($row['id'], 'planned failure');
    assert_equals(1, $q->size(), 'first failure stays queued (backoff 0s)');

    $row2 = $q->pop();
    assert_equals(2, (int) $row2['attempts']);
    $q->failed($row2['id'], 'planned failure');
    assert_equals(0, $q->size(), 'exhausted job leaves the hot table');
    $failed = $q->failedJobs();
    assert_equals(1, count($failed));
    assert_true(str_contains((string) $failed[0]['reason'], 'planned failure'));

    assert_true($q->retryFailed((int) $failed[0]['id']), 'queue:retry works');
    assert_equals(1, $q->size(), 'retried job is back on jobs');
    assert_equals(0, count($q->failedJobs()));

    $pdo->exec('DELETE FROM jobs');
    $pdo->exec('DELETE FROM failed_jobs');
});

test('2.5 DatabaseQueue reserves atomically: two pops get different jobs, expired reservation is reclaimed', function () {
    $q = new \Widdx\DatabaseQueue();
    $pdo = \Widdx\Database::connection()->pdo();
    $pdo->exec('DELETE FROM jobs');
    $q->push(\Widdx\Tests\TestJob::class, ['n' => 1]);
    $q->push(\Widdx\Tests\TestJob::class, ['n' => 2]);

    $a = $q->pop();
    $b = $q->pop();
    assert_true($a !== null && $b !== null, 'both jobs are handed out');
    assert_true((string) $a['id'] !== (string) $b['id'], 'two pops must return DIFFERENT rows, not the same job twice');
    // Both are now reserved within the visibility window -> nothing claimable.
    assert_true($q->pop() === null, 'reserved jobs stay hidden until the timeout');
    // A crashed worker's job (reservation far in the past) is reclaimed.
    $pdo->prepare('UPDATE jobs SET reserved_at = ? WHERE id = ?')->execute(['2000-01-01 00:00:00', $a['id']]);
    $d = $q->pop();
    assert_true($d !== null && (string) $d['id'] === (string) $a['id'], 'expired reservation is reclaimed');
    $pdo->exec('DELETE FROM jobs');
});

