/**
 * 2.19: the LAWS (AGENTS.md PART 2A) and the callable-API list (PART 23) are enforced as written.
 * Why this test exists: prose laws do not stop an agent from breaking them, and a handbook that
 * lists a name the code does not have teaches a fatal error (`Model` has no __callStatic). So the
 * doc is checked against reflection: it can neither quietly lose a law nor keep a phantom API.
 */
test('2.19 the LAWS in PART 2A and the API surface in PART 23 are enforceable as written', function () {
    $doc = (string) file_get_contents(__DIR__ . '/AGENTS.md');
    $api = (string) file_get_contents(__DIR__ . '/.agents/12-api-surface.md');
