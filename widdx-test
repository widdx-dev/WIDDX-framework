    $checked = 0;
    foreach (preg_split('/\n- \*\*/', $section) as $bullet) {
        $label = null;
        $target = null;
        foreach ($sources as $key => $value) {
            if (str_starts_with($bullet, $key)) {
                $label = $key;
                $target = $value;
                break;
            }
        }
        if ($label === null) {
            continue;
        }
        // Everything after "There is NO" is the negative list — real code, not the promise.
        $stop = strpos($bullet, 'There is NO');
        if ($stop !== false) {
            $bullet = substr($bullet, 0, $stop);
        }
        preg_match_all('/`([^`]*)`/', $bullet, $m);
        foreach ($m[1] as $run) {
            $run = (string) preg_replace('/\s+/', ' ', trim($run));
            // Only a pure space-separated name list counts; snippets like `db('users')` do not.
            if ($run === '' || preg_match('/^[a-z][a-zA-Z_]*(?: [a-z][a-zA-Z_]*)*$/i', $run) !== 1) {
                continue;
            }
            foreach (explode(' ', $run) as $name) {
                $checked++;
                $ok = $target === 'function' ? function_exists($name) : method_exists($target, $name);
                assert_true($ok, "PART 23 lists \"{$name}\" under {$label}, but it does not exist");
            }
        }
    }
    assert_true($checked >= 100, "PART 23 documents only {$checked} names — the section has been gutted");

    // A wrongly-labelled bullet is a fatal error in the reader's app, so static-ness is pinned too.
    foreach ([['query', true], ['create', true], ['count', true], ['where', true],
              ['save', false], ['delete', false], ['columns', false]] as [$name, $wantStatic]) {
        $rm = new \ReflectionMethod(\Widdx\Model::class, $name);
        assert_true($rm->isStatic() === $wantStatic,
            "Model::{$name}() changed static-ness — PART 23 now teaches it wrong");
    }

    // 5) The APIs the doc forbids must stay forbidden AND stay named, so the warning cannot rot.
    foreach (['Model::update', 'Model::destroy', 'Model::truncate',
              'QueryBuilder::pluck', 'Blueprint::unsignedBigInteger'] as $phantom) {
        [$short, $method] = explode('::', $phantom);
        assert_true(!method_exists('Widdx\\' . $short, $method),
            "{$phantom}() exists now — rewrite PART 23 instead of deleting this guard blind");
        assert_true(stripos($section, $method) !== false,
            "PART 23 must keep warning that {$phantom}() does not exist");
    }

    // 6) The two measured traps the laws rest on, proved here rather than asserted in prose.
    $controller = new class extends \Widdx\CrudController {
        protected string $model = \Widdx\Tests\Team::class;
    };
    $viewFolder = new \ReflectionMethod(\Widdx\CrudController::class, 'viewFolder');
    $viewFolder->setAccessible(true);
    assert_equals('teams', (string) $viewFolder->invoke($controller),
        'the CRUD view-override folder is the PLURAL table name');
    assert_true(str_contains($startDoc, 'views/products/index.php'),
        'PART 5 must teach the plural override folder');
    assert_true(!str_contains($startDoc, 'views/product/index.php'),
        'PART 5 revived the singular folder, which is silently never loaded');
    assert_true(str_contains($doc, 'views/post/index.php') && str_contains($doc, 'views/posts/'),
        'the binding layer must keep the silent-failure row about the plural view folder');

    $coreTemplateReachable = true;
    try {
        view('crud.index', ['items' => []]);
    } catch (\Throwable) {
        $coreTemplateReachable = false;
    }
    assert_true(!$coreTemplateReachable,
        'view() must not reach a core template from the project — PART 22 tells agents that');
    assert_true(str_contains($pitfalls, 'Never `view(\'crud.index\')`'),
        'PART 22 keeps the replacement recipe for a custom list page');
});

test('2.20 back() follows the Referer only when it points at this site', function () {
    $server = $_SERVER;
    $at = static function (string $referer, string $host): string {
        $_SERVER['HTTP_REFERER'] = $referer;
        $_SERVER['HTTP_HOST'] = $host;
        unset($_SERVER['HTTPS']);
        return (string) (back()->getHeaders()['Location'] ?? '(none)');
    };
    try {
        assert_equals('http://shop.test/products', $at('http://shop.test/products', 'shop.test'), 'same-host referer is followed as given');
        assert_equals('/', $at('http://evil.test/phish', 'shop.test'), 'off-site referer must be refused');
        assert_equals('/', $at('http://shop.test.evil.net/x', 'shop.test'), 'suffix-spoofed host must be refused');
        assert_equals('/', $at('//evil.net/x', 'shop.test'), 'protocol-relative referer must be refused');
        assert_equals('/', $at('/\\evil.net/x', 'shop.test'), 'backslash in a path-only referer must be refused');
        assert_equals('/', $at('/\\/evil.net/x', 'shop.test'), 'backslash before a scheme-like path must be refused');
        assert_equals('/', $at('javascript:alert(1)', 'shop.test'), 'a non-http(s) scheme must be refused');
        assert_equals('/', $at('ftp://shop.test/x', 'shop.test'), 'an ftp scheme must be refused');
        assert_equals('/', $at('http://user@shop.test/x', 'shop.test'), 'userinfo in the referer must be refused');
        assert_equals('/', $at('http://localhost:8000/x', 'evil.test:8000'), 'same port, different host is refused');
        assert_equals('/', $at('http://shop.test:8080/x', 'shop.test'), 'same host, different port is refused');
        assert_equals('https://shop.test/x', $at('https://shop.test/x', 'shop.test'), 'same host over another http(s) scheme is allowed — HTTPS probes must not break the redirect');
        assert_equals('/products', $at('/products', 'shop.test'), 'a path-only referer stays local');
        assert_equals('/', $at('', 'shop.test'), 'empty referer goes home');
    } finally {
        $_SERVER = $server;
    }
});

