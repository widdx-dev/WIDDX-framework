test('Auth: register + email verification + password reset lifecycle', function () {
    \Widdx\Schema::create('auth_users', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('name');
        $t->string('email')->unique();
        $t->string('password');
        $t->timestamp('email_verified_at')->nullable();
        $t->timestamps();
    });
    \Widdx\Schema::create('auth_tokens', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('email');
        $t->string('type');
        $t->string('token_hash');
        $t->timestamp('created_at')->nullable();
    });
    $pdo = \Widdx\Database::connection()->pdo();
    $pdo->exec('DELETE FROM auth_users');
    $pdo->exec('DELETE FROM auth_tokens');

    $mail = new \Widdx\LogMail();
    \Widdx\Mail::setConnection($mail);
    \Widdx\Auth::useModel(\Widdx\Tests\AuthUser::class);

    $user = \Widdx\Auth::register([
        'name' => 'Sara', 'email' => 'sara@widdx.test',
        'password' => 'supersecret1', 'password_confirmation' => 'supersecret1',
    ], false);
    assert_true(!empty($user->id), 'registered');
    assert_true(str_starts_with((string) $user->password, '$2y$'), 'password hashed');

    // verification mail went out automatically (column exists)
    $body = (string) ($mail->logged()[0]['body'] ?? '');
    preg_match('#/verify-email/([a-f0-9]{64})\?email=#', $body, $m);
    assert_true(!empty($m[1]), 'verify token present in mail body');
    assert_equals(false, \Widdx\Auth::verifyEmail('sara@widdx.test', 'deadbeef'), 'wrong token rejected');
    assert_true(\Widdx\Auth::verifyEmail('sara@widdx.test', $m[1]), 'valid token verifies');
    assert_true(!empty(\Widdx\Tests\AuthUser::find($user->id)->email_verified_at), 'flag stored');

    // password reset: unknown email → false; known → mailed token link
    assert_equals(false, \Widdx\Auth::sendResetLink('ghost@nowhere.test'));
    assert_true(\Widdx\Auth::sendResetLink('sara@widdx.test'));
    // 1.9: reset mail is deferred to Event::flush (post-response) on purpose.
    \Widdx\Event::flush();
    $resetBody = (string) ($mail->logged()[1]['body'] ?? '');
    preg_match('#/reset-password/([a-f0-9]{64})\?email=#', $resetBody, $m2);
    assert_true(!empty($m2[1]), 'reset token present');
    assert_equals(false, \Widdx\Auth::resetPassword('sara@widdx.test', $m2[1] . 'x', 'brandnewpass9'), 'tampered token rejected');
    assert_true(\Widdx\Auth::resetPassword('sara@widdx.test', $m2[1], 'brandnewpass9'));
    assert_true(password_verify('brandnewpass9', (string) \Widdx\Tests\AuthUser::find($user->id)->password), 'new password active');
    assert_equals(false, \Widdx\Auth::resetPassword('sara@widdx.test', $m2[1], 'thirdpass123'), 'tokens are single-use');

    \Widdx\Schema::dropIfExists('auth_users');
    \Widdx\Schema::dropIfExists('auth_tokens');
    \Widdx\Auth::useModel(null);
});

test('2.13 save() fills created_at/updated_at on any table that has them', function () {
    // Generators always add the two columns but no model sets $timestamps, so before
    // this behaviour every generated app stored NULL timestamps on a real HTTP create.
    // Drop first: Schema::create is IF NOT EXISTS, so a table left behind by an earlier
    // run (another PHP version sharing this database file) would return stale rows.
    \Widdx\Schema::dropIfExists('ts_auto');
    \Widdx\Schema::dropIfExists('ts_bare');
    \Widdx\Schema::create('ts_auto', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('label');
        $t->timestamps();
    });
    \Widdx\Schema::create('ts_bare', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('label');
    });

    $auto = new class extends \Widdx\Model { protected ?string $table = 'ts_auto'; protected array $fillable = ['label']; };
    $bare = new class extends \Widdx\Model { protected ?string $table = 'ts_bare'; protected array $fillable = ['label']; };
    $off  = new class extends \Widdx\Model { protected ?string $table = 'ts_auto'; protected array $fillable = ['label']; protected ?bool $timestamps = false; };

    $a = $auto::create(['label' => 'x']);
    assert_true(!empty($a->created_at), 'auto: created_at filled without any property');
    assert_true(!empty($a->updated_at), 'auto: updated_at filled without any property');
    // Bound parameter, keyed on the id just inserted: "label = \"x\"" parses as an
    // identifier on PostgreSQL, and the label alone is not unique across runs.
    $stored = \Widdx\Database::connection()->pdo()
        ->prepare('select created_at from ts_auto where id = ?');
    $stored->execute([$a->id]);
    $storedValue = (string) $stored->fetchColumn();
    // Leave no open cursor: SQLite reports "database table is locked" if a later
    // INSERT in this same test overlaps an unfinished SELECT.
    $stored->closeCursor();
    assert_equals((string) $a->created_at, $storedValue, 'auto: stored, not just in memory');

    $b = $bare::create(['label' => 'y']);
    assert_true(!empty($b->id), 'bare table: create still works with no timestamp columns');

    $c = $off::create(['label' => 'z']);
    assert_true(empty($c->created_at), 'explicit false wins over the columns being present');

    \Widdx\Schema::dropIfExists('ts_auto');
    \Widdx\Schema::dropIfExists('ts_bare');
});

