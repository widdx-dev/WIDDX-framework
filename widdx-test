test('2.12 every AI agent entry point points at AGENTS.md', function () {
    $root = __DIR__;
    if (!str_starts_with(rtrim((string) @file_get_contents($root . '/README.md')), '# Widdx')) {
        return; // scaffolded projects ship their own README — nothing to lint here
    }
    // Every tool that auto-loads its own instruction file must only POINT at the handbook.
    // A gate that restates facts is a second source of truth, and it drifts (three of them
    // did). Length is the proxy: a pointer is short.
    $gates = ['CLAUDE.md', '.cursorrules', 'llms.txt', 'GEMINI.md', '.github/copilot-instructions.md'];
    foreach ($gates as $g) {
        $body = @file_get_contents($root . '/' . $g);
        assert_true(is_string($body) && $body !== '', "agent gate missing: {$g}");
        assert_true(str_contains($body, 'AGENTS.md'), "{$g} must name AGENTS.md as the authoritative handbook");
        assert_true(strlen($body) < 2500, "{$g} grew past a pointer (" . strlen($body) . " bytes) — move the facts into AGENTS.md");
    }
    // A gate that exists only in the framework repo is useless where the agent actually
    // works: the generated project. Every gate must be in the `widdx new` copy list.
    $cli = (string) file_get_contents($root . '/widdx');
    foreach ($gates as $g) {
        assert_true(str_contains($cli, "'{$g}'"), "{$g} is not shipped by `php widdx new` — agents in a real project never see it");
    }
    // AGENTS.md is now a two-layer handbook: the binding layer plus .agents/*.md reference. If the
    // reference folder is not copied, every ROUTER row in a generated project points at nothing.
    assert_true(str_contains($cli, "/.agents'"),
        '.agents/ is not shipped by `php widdx new` — the ROUTER table is dead in a real project');
    assert_true(is_dir($root . '/.agents'), 'the .agents/ reference layer is missing');
});

/**
 * 2.12b: the split must not lose or duplicate anything.
 * Every PART heading the handbook used to carry still exists in exactly one file, every reference
 * file is reachable from the AGENTS.md router, and the binding layer stays small — that size is the
 * whole reason for the split (a long instruction file is one a model stops following).
 */
test('2.12b the two-layer handbook keeps every section, reachable and only once', function () {
    $root = __DIR__;
    if (!str_starts_with(rtrim((string) @file_get_contents($root . '/README.md')), '# Widdx')) {
        return; // scaffolded project
    }
    $layer1 = (string) file_get_contents($root . '/AGENTS.md');
    $files = (array) glob($root . '/.agents/*.md');
    assert_true(count($files) >= 13, 'the reference layer shrank to ' . count($files) . ' files');

    // One PART heading, one home — no section may exist in two files or in none.
    $homes = [];
    foreach ($files as $f) {
        $homes['.agents/' . basename($f)] = (string) file_get_contents($f);
    }
    $all = array_merge(['AGENTS.md' => $layer1], $homes);
    $homesByPart = [];
    foreach ($all as $name => $body) {
        preg_match_all('/^## (PART [0-9A-Z]+) —/m', $body, $m);
        foreach ($m[1] as $part) {
            if (!isset($homesByPart[$part])) {
                $homesByPart[$part] = [];
            }
            $homesByPart[$part][] = $name;
        }
    }
    foreach ($homesByPart as $part => $where) {
        assert_true(count($where) === 1,
            "{$part} lives in " . count($where) . ' files (' . implode(', ', $where) . ') — one home each');
    }
    // The section list the handbook had before the split must all still be present.
    foreach (['PART 0', 'PART 1', 'PART 2', 'PART 2A', 'PART 3', 'PART 4', 'PART 5', 'PART 6', 'PART 7',
              'PART 8', 'PART 9', 'PART 10', 'PART 11', 'PART 12', 'PART 13', 'PART 14', 'PART 15',
              'PART 16', 'PART 17', 'PART 18', 'PART 19', 'PART 20', 'PART 21', 'PART 22', 'PART 23',
              'PART 24'] as $part) {
        assert_true(isset($homesByPart[$part]), "{$part} vanished from the handbook in the split");
    }

    // Every reference file is routed to from the binding layer, and links back.
    foreach ($files as $f) {
        $rel = '.agents/' . basename($f);
        assert_true(str_contains($layer1, $rel), "{$rel} is not in the AGENTS.md ROUTER table");
        assert_true(str_contains((string) file_get_contents($f), 'AGENTS.md'),
            "{$rel} does not point back at the binding layer");
        $size = strlen((string) file_get_contents($f));
        assert_true($size < 9000, "{$rel} is {$size} bytes — split it further, the point is one focused read");
    }

    // The binding layer is the file every tool loads on every request. Keep it small.
    assert_true(strlen($layer1) < 12000,
        'AGENTS.md grew to ' . strlen($layer1) . ' bytes — move prose into .agents/ and route to it');
    // And it must still hold the binding content, not just links.
    foreach (['## PART 2A — THE LAWS', '### Law of file placement', '### Definition of done',
              '## SILENT FAILURES', '## ROUTER'] as $h) {
        assert_true(str_contains($layer1, $h), "AGENTS.md lost the binding section \"{$h}\"");
    }
});

