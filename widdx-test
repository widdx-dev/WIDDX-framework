    assert_true(\Widdx\Auth::resetPassword('sara@widdx.test', $m2[1], 'brandnewpass9'));
    assert_true(password_verify('brandnewpass9', (string) \Widdx\Tests\AuthUser::find($user->id)->password), 'new password active');
