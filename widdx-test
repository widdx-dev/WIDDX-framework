});

test('2.13 save() fills created_at/updated_at on any table that has them', function () {
    // Generators always add the two columns but no model sets $timestamps, so before
    // this behaviour every generated app stored NULL timestamps on a real HTTP create.
    // Drop first: Schema::create is IF NOT EXISTS, so a table left behind by an earlier
    // run (another PHP version sharing this database file) would return stale rows.
    \Widdx\Schema::dropIfExists('ts_auto');
    \Widdx\Schema::dropIfExists('ts_bare');
    \Widdx\Schema::create('ts_auto', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('label');
        $t->timestamps();
    });
    \Widdx\Schema::create('ts_bare', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('label');
    });

    $auto = new class extends \Widdx\Model { protected ?string $table = 'ts_auto'; protected array $fillable = ['label']; };
    $bare = new class extends \Widdx\Model { protected ?string $table = 'ts_bare'; protected array $fillable = ['label']; };
    $off  = new class extends \Widdx\Model { protected ?string $table = 'ts_auto'; protected array $fillable = ['label']; protected bool $timestamps = false; };
    // Plain `bool` on purpose: the README used to teach `protected bool $timestamps = true;`,
    // and property types are invariant in PHP, so widening the base to ?bool would make every
    // such existing model fatal on autoload.
    $forced = new class extends \Widdx\Model { protected ?string $table = 'ts_bare'; protected array $fillable = ['label']; protected bool $timestamps = true; };

    $a = $auto::create(['label' => 'x']);
    assert_true(!empty($a->created_at), 'auto: created_at filled without any property');
    assert_true(!empty($a->updated_at), 'auto: updated_at filled without any property');
    // Bound parameter, keyed on the id just inserted: "label = \"x\"" parses as an
    // identifier on PostgreSQL, and the label alone is not unique across runs.
    $stored = \Widdx\Database::connection()->pdo()
        ->prepare('select created_at from ts_auto where id = ?');
    $stored->execute([$a->id]);
    $storedValue = (string) $stored->fetchColumn();
    // Leave no open cursor: SQLite reports "database table is locked" if a later
    // INSERT in this same test overlaps an unfinished SELECT.
    $stored->closeCursor();
    assert_equals((string) $a->created_at, $storedValue, 'auto: stored, not just in memory');

    $b = $bare::create(['label' => 'y']);
    assert_true(!empty($b->id), 'bare table: create still works with no timestamp columns');

    $f = $forced::create(['label' => 'w']);
    assert_true(!empty($f->id), 'true + missing columns: skipped, not a failed INSERT');
    assert_true(empty($f->created_at), 'true + missing columns: nothing invented');

    $c = $off::create(['label' => 'z']);
    assert_true(empty($c->created_at), 'explicit false wins over the columns being present');

    \Widdx\Schema::dropIfExists('ts_auto');
    \Widdx\Schema::dropIfExists('ts_bare');
});

test('2.14 a relative DB_DATABASE resolves to the project, never to the process CWD', function () {
    // .env.example ships DB_DATABASE=./database.sqlite, and neither the CLI nor the
    // web entry point chdirs, so cron or a web server with another CWD used to open
    // (and silently create) a second database: migrate wrote one file, the app read
    // the other, and the failure surfaced as "no such table: users".
    $base = \Widdx\Database::projectDirectory();
    assert_equals($base . '/database.sqlite', \Widdx\Database::resolveSqlitePath('./database.sqlite', $base));
    assert_equals($base . '/database.sqlite', \Widdx\Database::resolveSqlitePath('database.sqlite', $base));
    assert_equals($base . '/storage/app/my.db', \Widdx\Database::resolveSqlitePath('storage/app/my.db', $base));
    assert_equals('/var/data/x.sqlite', \Widdx\Database::resolveSqlitePath('/var/data/x.sqlite', $base));
    assert_equals(':memory:', \Widdx\Database::resolveSqlitePath(':memory:', $base));
    assert_equals('C:\\widdx\\db.sqlite', \Widdx\Database::resolveSqlitePath('C:\\widdx\\db.sqlite', $base));

    // The behaviour that matters, measured by opening a real connection from a foreign CWD.
    $far = sys_get_temp_dir() . '/widdx-cwd-far';
    @mkdir($far, 0775, true);
    @unlink($far . '/cwd_probe.sqlite');
    @unlink($base . '/cwd_probe.sqlite');
    $previous = getcwd();
    chdir($far);
    try {
        $db = new \Widdx\Database(['driver' => 'sqlite', 'database' => 'cwd_probe.sqlite']);
        $db->pdo()->exec('create table if not exists cwd_probe (id integer primary key, x text)');
    } finally {
        chdir($previous);
    }
    assert_true(is_file($base . '/cwd_probe.sqlite'), 'the project file is the one that opened');
    assert_true(!is_file($far . '/cwd_probe.sqlite'), 'no stray database was created in the CWD');
    @unlink($base . '/cwd_probe.sqlite');
    @rmdir($far);
});

/**
 * 2.15: the timestamps column probe is cached per table, so this process has to
 * drop that answer whenever it changes the schema. A migration adding or removing
 * the pair after a model already wrote a row used to keep the old answer for the
 * rest of the run — which is exactly what `php widdx migrate` followed by a
 * create in the same process does.
 */
test('2.15 changing a table invalidates the cached timestamp probe', function () {
    \Widdx\Schema::dropIfExists('ts_cache');
    \Widdx\Schema::create('ts_cache', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('label');
    });
    $model = new class extends \Widdx\Model {
        protected ?string $table = 'ts_cache';
        protected array $fillable = ['label'];
    };

    $before = $model::create(['label' => 'no columns yet']);
    assert_true(empty($before->created_at), 'bare table: nothing filled');

    \Widdx\Schema::table('ts_cache', function (\Widdx\Blueprint $t) {
        $t->timestamps();
    });
    $after = $model::create(['label' => 'pair added inside this process']);
    assert_true(!empty($after->created_at), 'after adding the pair, the same model fills them');

    // And the other direction: recreating the table bare must not leave "yes" cached.
    \Widdx\Schema::dropIfExists('ts_cache');
    \Widdx\Schema::create('ts_cache', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('label');
    });
    $again = $model::create(['label' => 'recreated bare']);
    assert_true(empty($again->created_at), 'after recreating without the pair, nothing fills');

    \Widdx\Schema::dropIfExists('ts_cache');
});

/**
 * 2.16: min/max/size count characters without ext-mbstring. Shared hosting often
 * builds PHP without it, and an unguarded mb_strlen() there is a fatal error in the
 * middle of validating a form, not a failed rule.
 */
test('2.16 string length rules count characters without ext-mbstring', function () {
    $pcre = new \ReflectionMethod(\Widdx\Request::class, 'textLengthPcre');
    $pcre->setAccessible(true);
    $count = fn (string $s): int => (int) $pcre->invoke(null, $s);

    assert_equals(3, $count('abc'), 'ascii');
    assert_equals(5, $count('مرحبا'), 'arabic counts characters, not bytes');
    assert_equals(5, $count('👋👋👋👋👋'), 'emoji count as one character each');
    if (function_exists('mb_strlen')) {
        assert_equals(mb_strlen('مرحبا بالعالم'), $count('مرحبا بالعالم'), 'matches mb_strlen');
    }
    // Undecodable bytes must fall back to a length, never a fatal or false.
    assert_equals(4, $count("a\xFFb\xFF"), 'invalid UTF-8 falls back to byte length');

    // The rules reach it through a real request, not just the helper.
    $r = fn (string $rules) => (new \Widdx\Request([], ['title' => 'مرحبا'], ['REQUEST_METHOD' => 'POST']))
        ->validate(['title' => $rules]);
    $passed = $r('required|string|max:5');
    assert_equals('مرحبا', $passed['title'], 'max:5 accepts a 5-character arabic word');
    $rejected = false;
    try {
        $r('required|string|max:4');
    } catch (\Widdx\Exceptions\ValidationException) {
        $rejected = true;
    }
    assert_true($rejected, 'max:4 rejects it');
});

/**
 * 2.17: isset() has to answer about relations the same way __get does.
 * `$user->roles ?? []` returned the
 * default while `count($user->roles)` returned the rows, because __isset looked at
 * attributes only. Any guard or list written with ?? therefore saw NOTHING — no error,
 * no log line, just an empty permission check on a user who has roles.
 */
test('2.17 isset() and ?? see relations, not only columns', function () {
    // The ORM test above drops its tables when it finishes, so this one builds its own.
    \Widdx\Schema::create('teams', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('name');
    });
    \Widdx\Schema::create('players', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->integer('team_id');
        $t->string('name');
    });
    $team = \Widdx\Tests\Team::create(['name' => 'IssetAlpha']);
    \Widdx\Tests\Player::create(['name' => 'IssetP1', 'team_id' => $team->id]);
    $fresh = \Widdx\Tests\Team::find($team->id);

    assert_true(isset($fresh->players), 'a hasMany relation answers isset');
    assert_equals(1, count($fresh->players ?? []), '?? yields the rows, never the default');
    assert_true(($fresh->players ?? null) !== null, '?? does not fall back on a loaded relation');

    // A relation that resolves to null is genuinely absent and must keep ?? semantics.
    $bare = \Widdx\Tests\Team::find(\Widdx\Tests\Team::create(['name' => 'IssetBeta'])->id);
    assert_true(!isset($bare->captain), 'a hasOne with no row is not set');
    assert_equals('none', $bare->captain ?? 'none', '?? falls back for a null relation');

    // ?? must not cost a second query after it resolved the relation.
    $probe = \Widdx\Tests\Team::find($team->id);
    $probe->players ?? [];
    assert_true($probe->relationLoaded('players'), '?? cached the relation like __get does');

    // Plain attribute semantics unchanged.
    assert_true(isset($fresh->name), 'column is set');
    assert_true(!isset($fresh->no_such_column), 'unknown name is still not set');
    // Bound parameters: `name = "x"` parses as an identifier on PostgreSQL.
    $pdo = \Widdx\Database::connection()->pdo();
    $del = $pdo->prepare('DELETE FROM players WHERE name = ?');
    $del->execute(['IssetP1']);
    $del->closeCursor();
    $del2 = $pdo->prepare('DELETE FROM teams WHERE name IN (?, ?)');
    $del2->execute(['IssetAlpha', 'IssetBeta']);
    $del2->closeCursor();
});

/**
 * 2.18: every Model static AGENTS.md PART 8 teaches must be callable.
 * PART 8 promised `Post::count()`; the suite never called it, so it stayed a fatal error
 * until a project written by another agent tripped on it. The doc is now the input.
 */
test('2.18 every Model:: static promised in the models reference exists', function () {
    $doc = (string) file_get_contents(__DIR__ . '/.agents/03-models-relations.md');
    $start = strpos($doc, '## PART 8');
    $end = strpos($doc, '## PART 9');
    assert_true($start !== false && $end !== false && $end > $start, 'PART 8 section found in the reference layer');
    $section = substr($doc, $start, $end - $start);

    $seen = 0;
    foreach (explode("\n", $section) as $line) {
        // The section deliberately contains a NEGATIVE example ("Post::columns() is a
        // fatal error"), which must not be held to the promise it is warning about.
        if (stripos($line, 'fatal') !== false || str_contains($line, 'WRONG')) {
            continue;
        }
