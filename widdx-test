    foreach (['## PART 2A — THE LAWS', '### Law of file placement', '### Definition of done',
              '## SILENT FAILURES', '## ROUTER'] as $heading) {
        assert_true(str_contains($doc, $heading), "AGENTS.md lost the binding heading: {$heading}");
    }
    assert_true(str_contains($api, '## PART 23 — The real API surface'),
        'the reference layer lost the API-surface heading');
    assert_true(str_contains((string) file_get_contents(__DIR__ . '/.agents/13-expert-notes.md'),
                             '## PART 24 — Expert notes'), 'the reference layer lost the expert-notes heading');
    for ($n = 1; $n <= 13; $n++) {
        assert_true(str_contains($doc, "**L{$n} —"), "AGENTS.md lost law L{$n}");
    }
    // L2 is only a law if the list it points at is reachable from the binding layer.
    assert_true(str_contains($doc, '.agents/12-api-surface.md'), 'law L2 no longer routes to the API surface file');

