test('ORM relations: lazy access, eager loading, pivot, nested chains', function () {
    $pdo = \Widdx\Database::connection()->pdo();
    $pdo->exec('CREATE TABLE IF NOT EXISTS teams (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)');
    $pdo->exec('CREATE TABLE IF NOT EXISTS players (id INTEGER PRIMARY KEY AUTOINCREMENT, team_id INTEGER, name TEXT)');
    $pdo->exec('CREATE TABLE IF NOT EXISTS roles (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)');
    $pdo->exec('CREATE TABLE IF NOT EXISTS permissions (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT)');
    $pdo->exec('CREATE TABLE IF NOT EXISTS permission_role (id INTEGER PRIMARY KEY AUTOINCREMENT, role_id INTEGER, permission_id INTEGER)');
    foreach (['players', 'teams', 'permission_role', 'roles', 'permissions'] as $t) {
        $pdo->exec("DELETE FROM {$t}");
    }

    $alpha = \Widdx\Tests\Team::create(['name' => 'Alpha']);
    \Widdx\Tests\Player::create(['name' => 'P1', 'team_id' => $alpha->id]);
    \Widdx\Tests\Player::create(['name' => 'P2', 'team_id' => $alpha->id]);
    $beta = \Widdx\Tests\Team::create(['name' => 'Beta']);
    \Widdx\Tests\Player::create(['name' => 'P3', 'team_id' => $beta->id]);

    // Lazy magic property: $team->players with no definition beyond hasMany(X::class)
    $fresh = \Widdx\Tests\Team::find($alpha->id);
    assert_equals(2, count($fresh->players), 'hasMany lazy');

    // hasOne returns at most one child (regression: HasOne must extend Relation,
    // not HasMany — mixed vs array return covariance is a load-time fatal).
    assert_equals('P1', $fresh->captain->name, 'hasOne lazy');

    // Eager hasMany + belongsTo
    $teams = \Widdx\Tests\Team::with('players')->get();
    assert_true($teams[0]->relationLoaded('players'), 'eager must mark loaded');
    assert_equals(2, count($teams[0]->players));
    assert_equals(1, count($teams[1]->players));

    $teamsOne = \Widdx\Tests\Team::with('captain')->get();
    assert_true($teamsOne[0]->relationLoaded('captain'), 'hasOne eager marks loaded');
    assert_equals('P1', $teamsOne[0]->captain->name, 'hasOne eager first wins');

    $players = \Widdx\Tests\Player::with('team')->get();
    assert_equals('Alpha', $players[0]->team->name, 'belongsTo eager');

    // Nested chain: players.team.players
    $deep = \Widdx\Tests\Player::with('team.players')->get();
    assert_true($deep[0]->team->relationLoaded('players'), 'nested eager');
    assert_equals(2, count($deep[0]->team->players));

    // Pivot belongsToMany both directions
    $role = \Widdx\Tests\Role::create(['name' => 'admin']);
    $perm = \Widdx\Tests\Permission::create(['name' => 'edit']);
    $pdo->exec("INSERT INTO permission_role (role_id, permission_id) VALUES ({$role->id}, {$perm->id})");
    $roles = \Widdx\Tests\Role::with('permissions')->get();
    assert_equals(1, count($roles[0]->permissions), 'pivot eager');
    assert_equals('edit', $roles[0]->permissions[0]->name);
    assert_equals('admin', \Widdx\Tests\Permission::with('roles')->get()[0]->roles[0]->name, 'pivot inverse');

    // Unknown relation fails loudly with guidance
    try {
        \Widdx\Tests\Team::with('ghosts')->get();
        assert_true(false, 'unknown relation must throw');
    } catch (\Widdx\Exceptions\ModelException $e) {
        assert_true(str_contains($e->getMessage(), 'hasMany'));
    }

    foreach (['players', 'teams', 'permission_role', 'roles', 'permissions'] as $t) {
        $pdo->exec("DROP TABLE IF EXISTS {$t}");
    }
});

test('UploadedFile: file/image/mimes/max rules + store() to the disk', function () {
    $gif = base64_decode('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7');
    $src = tempnam(sys_get_temp_dir(), 'widdx-up');
    file_put_contents($src, $gif);
    $raw = ['cover' => ['name' => 'sea.gif', 'type' => 'image/gif', 'tmp_name' => $src, 'error' => 0, 'size' => strlen($gif)]];

    $req = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'POST'], $raw);
    assert_true($req->file('cover') instanceof \Widdx\UploadedFile, 'file() normalizes');
    assert_true($req->file('cover')->isImage(), 'real gif detected');

    $data = $req->validate(['cover' => 'required|image|mimes:gif,png|max:10']);
    assert_true($data['cover'] instanceof \Widdx\UploadedFile, 'upload passes file rules');

    // Missing upload fails 'required'
    $req2 = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'POST']);
    try {
        $req2->validate(['cover' => 'required|image']);
        assert_true(false, 'missing upload must fail required');
    } catch (\Widdx\Exceptions\ValidationException $e) {
        assert_true(str_contains($e->errors['cover'][0], 'required'));
    }

    // An already-stored PATH string passes upload rules (create re-validation)
    $req4 = new \Widdx\Request([], ['cover' => 'photos/20260113_ab_sea.gif'], ['REQUEST_METHOD' => 'POST']);
    $revalidated = $req4->validate(['cover' => 'required|image|mimes:png']);
    assert_equals('photos/20260113_ab_sea.gif', $revalidated['cover'], 'stored path must survive upload rules');

    // Wrong extension fails 'mimes' with the values placeholder
    $req3 = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'POST'], [
        'cover' => ['name' => 'a.jpg', 'type' => 'image/jpeg', 'tmp_name' => $src, 'error' => 0, 'size' => strlen($gif)],
    ]);
    try {
        $req3->validate(['cover' => 'image|mimes:png']);
        assert_true(false, 'mimes must reject jpg');
    } catch (\Widdx\Exceptions\ValidationException $e) {
        assert_true(str_contains($e->errors['cover'][0], 'type: png'), $e->errors['cover'][0] ?? '');
    }

    // Too big fails 'max' (kilobytes)
    try {
        $req->validate(['cover' => 'max:0']);
        assert_true(false, 'max must reject');
    } catch (\Widdx\Exceptions\ValidationException $e) {
        assert_true(str_contains($e->errors['cover'][0], 'kilobytes'), $e->errors['cover'][0] ?? '');
    }

    // store() persists to the disk and returns a relative path
    $rel = $req->file('cover')->store('unittest');
    $abs = WIDDX_BASE_PATH . '/storage/app/' . $rel;
    assert_true(str_starts_with($rel, 'unittest/') && is_file($abs), 'stored at ' . $rel);
    @unlink($abs);
    @unlink($src);
});

test('Request::ip(): X-Forwarded-For honored only for trusted proxies', function () {
    \Widdx\Request::setTrustedProxies(null); // no trusted list (unit env)
    $req = new \Widdx\Request([], [], ['REMOTE_ADDR' => '198.51.100.5', 'HTTP_X_FORWARDED_FOR' => '9.9.9.9']);
    assert_equals('198.51.100.5', $req->ip(), 'untrusted peer cannot spoof via XFF');

    \Widdx\Request::setTrustedProxies(['198.51.100.5']);
    $req2 = new \Widdx\Request([], [], ['REMOTE_ADDR' => '198.51.100.5', 'HTTP_X_FORWARDED_FOR' => '1.1.1.1, 2.2.2.2']);
    assert_equals('2.2.2.2', $req2->ip(), 'right-most hop from the trusted proxy');
    \Widdx\Request::setTrustedProxies(null);
});

test('DatabaseQueue: retry with backoff, then failed_jobs, then queue:retry', function () {
    $q = new \Widdx\DatabaseQueue();
    $pdo = \Widdx\Database::connection()->pdo();
    $pdo->exec('DELETE FROM jobs');
    $pdo->exec('DELETE FROM failed_jobs');

    $q->push(\Widdx\Tests\FailingJob::class, ['n' => 1]);
    $row = $q->pop();
    assert_true($row !== null);
    assert_equals(1, (int) $row['attempts'], 'pop reports the NEW attempt number');
    assert_equals(2, (int) $row['payload']['tries'], 'job $tries embedded at push time');
    $q->failed($row['id'], 'planned failure');
    assert_equals(1, $q->size(), 'first failure stays queued (backoff 0s)');

    $row2 = $q->pop();
    assert_equals(2, (int) $row2['attempts']);
    $q->failed($row2['id'], 'planned failure');
    assert_equals(0, $q->size(), 'exhausted job leaves the hot table');
    $failed = $q->failedJobs();
    assert_equals(1, count($failed));
    assert_true(str_contains((string) $failed[0]['reason'], 'planned failure'));

    assert_true($q->retryFailed((int) $failed[0]['id']), 'queue:retry works');
    assert_equals(1, $q->size(), 'retried job is back on jobs');
    assert_equals(0, count($q->failedJobs()));

    $pdo->exec('DELETE FROM jobs');
    $pdo->exec('DELETE FROM failed_jobs');
});

test('Schedule: time buckets, when-gate and identity keys', function () {
    \Widdx\Schedule::flush();
    $t = \Widdx\Schedule::command('queue:work')->everyFiveMinutes();
    assert_true($t->due(-1), 'never run = due');
    assert_equals(false, $t->due($t->bucket()), 'same bucket = not due again');
    assert_true($t->due($t->bucket() - 1), 'previous bucket = due');
    $gated = \Widdx\Schedule::call(fn() => null)->hourly()->when(fn() => false);
    assert_equals(false, $gated->due(-1), 'when(false) blocks forever');
    assert_true($t->key() !== $gated->key(), 'distinct tasks → distinct keys');
    assert_equals(2, count(\Widdx\Schedule::events()));
    \Widdx\Schedule::flush();
});

test('Gate: abilities, authorize() 403, and policy convention', function () {
    \Widdx\Gate::flush();
    \Widdx\Gate::define('publish', fn(mixed $user) => $user !== null);
    assert_true(\Widdx\Gate::has('publish'), 'defined ability is a guard');
    assert_equals(false, \Widdx\Gate::allows('publish'), 'guest denied by default logic');
    \Widdx\Gate::define('publish', fn(mixed $user) => true);
    assert_true(\Widdx\Gate::allows('publish'));

    \Widdx\Gate::policy(\Widdx\Tests\Team::class, \Widdx\Tests\TeamPolicy::class);
    assert_true(\Widdx\Gate::allows('viewAny', \Widdx\Tests\Team::class), 'policy allows viewAny');
    assert_equals(false, \Widdx\Gate::allows('delete', new \Widdx\Tests\Team()), 'policy denies delete');
    assert_equals(false, \Widdx\Gate::allows('unknownAbility', new \Widdx\Tests\Team()), 'policy without method = deny');

    try {
        \authorize('never.defined');
        assert_true(false, 'authorize must 403 undefined abilities');
    } catch (\Widdx\Exceptions\HttpException $e) {
        assert_equals(403, $e->status);
    }
    \Widdx\Gate::flush();
});

test('Auth: register + email verification + password reset lifecycle', function () {
    $pdo = \Widdx\Database::connection()->pdo();
    $pdo->exec('CREATE TABLE IF NOT EXISTS auth_users (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT, email TEXT UNIQUE, password TEXT, email_verified_at TEXT, created_at TEXT, updated_at TEXT)');
    $pdo->exec('CREATE TABLE IF NOT EXISTS auth_tokens (id INTEGER PRIMARY KEY AUTOINCREMENT, email TEXT, type TEXT, token_hash TEXT, created_at TEXT)');
    $pdo->exec('DELETE FROM auth_users');
    $pdo->exec('DELETE FROM auth_tokens');

    $mail = new \Widdx\LogMail();
    \Widdx\Mail::setConnection($mail);
    \Widdx\Auth::useModel(\Widdx\Tests\AuthUser::class);

    $user = \Widdx\Auth::register([
        'name' => 'Sara', 'email' => 'sara@widdx.test',
        'password' => 'supersecret1', 'password_confirmation' => 'supersecret1',
    ], false);
    assert_true(!empty($user->id), 'registered');
    assert_true(str_starts_with((string) $user->password, '$2y$'), 'password hashed');

    // verification mail went out automatically (column exists)
    $body = (string) ($mail->logged()[0]['body'] ?? '');
    preg_match('#/verify-email/([a-f0-9]{64})\?email=#', $body, $m);
    assert_true(!empty($m[1]), 'verify token present in mail body');
    assert_equals(false, \Widdx\Auth::verifyEmail('sara@widdx.test', 'deadbeef'), 'wrong token rejected');
    assert_true(\Widdx\Auth::verifyEmail('sara@widdx.test', $m[1]), 'valid token verifies');
    assert_true(!empty(\Widdx\Tests\AuthUser::find($user->id)->email_verified_at), 'flag stored');

    // password reset: unknown email → false; known → mailed token link
    assert_equals(false, \Widdx\Auth::sendResetLink('ghost@nowhere.test'));
    assert_true(\Widdx\Auth::sendResetLink('sara@widdx.test'));
    $resetBody = (string) ($mail->logged()[1]['body'] ?? '');
    preg_match('#/reset-password/([a-f0-9]{64})\?email=#', $resetBody, $m2);
    assert_true(!empty($m2[1]), 'reset token present');
    assert_equals(false, \Widdx\Auth::resetPassword('sara@widdx.test', $m2[1] . 'x', 'brandnewpass9'), 'tampered token rejected');
    assert_true(\Widdx\Auth::resetPassword('sara@widdx.test', $m2[1], 'brandnewpass9'));
    assert_true(password_verify('brandnewpass9', (string) \Widdx\Tests\AuthUser::find($user->id)->password), 'new password active');
    assert_equals(false, \Widdx\Auth::resetPassword('sara@widdx.test', $m2[1], 'thirdpass123'), 'tokens are single-use');

    $pdo->exec('DROP TABLE auth_users');
    $pdo->exec('DROP TABLE auth_tokens');
    \Widdx\Auth::useModel(null);
});

