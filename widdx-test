test('2.22 silent-failure guards: count() limit, array where, stale save, missing table', function () {
    \Widdx\App::basePath(WIDDX_BASE_PATH);
    \Widdx\Schema::create('wc2_items', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('name');
    });
    $clean = static function () {
        try { db('wc2_items')->where('id', '>', 0)->delete(); } catch (\Throwable) {}
    };
    $clean();
    db('wc2_items')->insert(['name' => 'a']);
    db('wc2_items')->insert(['name' => 'b']);
    db('wc2_items')->insert(['name' => 'c']);

    // 1. count() respects limit/offset — silently returning the global total is gone
    assert_equals(2, db('wc2_items')->limit(2)->count(), 'count() with limit counts that page, not the whole table');
    assert_equals(3, db('wc2_items')->count(), 'count() without limit stays the total');

    // 3. where(col, [array]) means IN, not an array jammed into a scalar bind
    assert_equals(2, count(db('wc2_items')->where('name', ['a', 'b'])->get()), 'where(col, [array]) must behave as IN');

    // 3b. an array value with a non-IN operator throws clearly instead of 0 rows
    $threw = false;
    try {
        db('wc2_items')->where('name', '=', ['a'])->get();
    } catch (\Widdx\Exceptions\DatabaseException $e) {
        $threw = true;
        assert_true(str_contains($e->getMessage(), 'IN'), 'must name IN/NOT IN: ' . $e->getMessage());
    }
    assert_true($threw, 'array value with non-IN operator must throw, not silently return nothing');

    // 2. save() on a row deleted behind its back reports false, not a silent "true"
    $model = new class extends \Widdx\Model { protected ?string $table = 'wc2_items'; protected array $fillable = ['*']; };
    $m = $model::create(['name' => 'target']);
    $loaded = $model::find($m->id);
    db('wc2_items')->where('id', $m->id)->delete();
    $loaded->name = 'changed-after-delete';
    assert_equals(false, $loaded->save(), 'save() must not claim success when the row no longer exists');

    // 4. a genuinely missing table is the documented []; a real failure is NOT swallowed
    assert_equals([], \Widdx\Database::connection()->tableColumns('wc2_no_such_table'), 'missing table => empty array contract');

    \Widdx\Schema::dropIfExists('wc2_items');
});

test('2.23 the five production findings: installer debug default, upload dir escape, CORS allowlist, token indexes + prune, dead config key', function () {
    // 1. SEC-01 — a first run of public/install.php must not pre-check APP_DEBUG:
    // the page warns that the framework defaults to OFF while the box said ON.
    $install = (string) file_get_contents(__DIR__ . '/public/install.php');
    assert_true(str_contains($install, "!empty(\$old['APP_DEBUG']) ? 'checked'"), 'install page must start with debug OFF');
    assert_true(!str_contains($install, "\$old === [] ? 'checked'"), 'a first GET must not pre-check the debug box');
    $envOff = \Widdx\Installer::buildEnv(['DB_CONNECTION' => 'sqlite', 'APP_URL' => 'http://localhost']);
    assert_true(str_contains($envOff, 'APP_DEBUG=false'), 'unticked box writes APP_DEBUG=false: ' . $envOff);
    $envOn = \Widdx\Installer::buildEnv(['DB_CONNECTION' => 'sqlite', 'APP_DEBUG' => '1']);
    assert_true(str_contains($envOn, 'APP_DEBUG=true'), 'a ticked box still means ON');

    // 2. SEC-02 — store() built its target from root() and skipped the disk's own
    // traversal guard, so a caller passing user input could write outside it.
    $gif = base64_decode('R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7');
    $uploadSrc = tempnam(sys_get_temp_dir(), 'widdx-esc');
    file_put_contents($uploadSrc, $gif);
    $mk = static fn () => new \Widdx\UploadedFile($uploadSrc, 'sea.gif', 'image/gif', UPLOAD_ERR_OK, strlen($gif));
    foreach (['../../public', '../outside', '/etc/passwd-dir', 'a/../../b', '..\\..\\public'] as $bad) {
        $threw = false;
        try {
            $mk()->store($bad);
        } catch (\Widdx\Exceptions\HttpException) {
            $threw = true;
        }
        assert_true($threw, 'store() must refuse a directory that escapes the disk: ' . $bad);
    }
    $stored = $mk()->store('unittest/2026');
    assert_true(str_starts_with($stored, 'unittest/2026/'), 'a normal nested directory still stores: ' . $stored);
    @unlink(WIDDX_BASE_PATH . '/storage/app/' . $stored);
    @unlink($uploadSrc);

    // 3. SEC-03 — the preflight answer is the intersection of what is allowed and
    // what was asked, never a copy of the request.
    $prop = (new \ReflectionClass(\Widdx\App::class))->getProperty('config');
    $savedConfig = $prop->getValue();
    try {
        $prop->setValue(null, ['cors' => [
            'allowed_origins' => ['https://app.test'],
            'allowed_methods' => ['GET', 'POST'],
            'allowed_headers' => ['Content-Type', 'Authorization'],
            'allow_credentials' => false,
            'max_age' => 60,
        ]]);
        $pre = new \Widdx\Request([], [], [
            'REQUEST_METHOD' => 'OPTIONS',
            'HTTP_ORIGIN' => 'https://app.test',
            'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
            'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => 'authorization, X-evil, Cookie',
        ]);
        $grant = (new \Widdx\CorsMiddleware())->handle($pre, static fn () => \Widdx\Response::make(''))->getHeaders();
        $allowHeaders = (string) ($grant['Access-Control-Allow-Headers'] ?? '');
        assert_true(!str_contains($allowHeaders, 'X-evil'), 'a header outside the allowlist must not be granted: ' . $allowHeaders);
        assert_true(!str_contains($allowHeaders, 'Cookie'), 'Cookie must never be echoed: ' . $allowHeaders);
        assert_equals('Authorization', trim($allowHeaders), 'the answer is exactly the intersection, matched case-insensitively');

        // '*' + credentials is the combination browsers reject — it must not be sent.
        $prop->setValue(null, ['cors' => [
            'allowed_origins' => ['*'], 'allowed_methods' => ['GET'],
            'allowed_headers' => [], 'allow_credentials' => true, 'max_age' => 60,
        ]]);
        $wild = (new \Widdx\CorsMiddleware())->handle(
            new \Widdx\Request([], [], ['REQUEST_METHOD' => 'GET', 'HTTP_ORIGIN' => 'https://app.test']),
            static fn () => \Widdx\Response::make('')
        )->getHeaders();
        assert_true(!isset($wild['Access-Control-Allow-Credentials']), 'credentials must not be granted for a wildcard origin');
        assert_equals('*', (string) ($wild['Access-Control-Allow-Origin'] ?? ''), 'the wildcard itself stays a wildcard');
    } finally {
        $prop->setValue(null, $savedConfig);
    }

    // 4. PERF-01 — the auth_tokens stub must index the columns tokenValid() filters
    // on, and an unused token must not accumulate forever.
    $cli = (string) file_get_contents(__DIR__ . '/widdx');
    $stub = substr($cli, (int) strpos($cli, '_create_auth_tokens_table.php'), 1800);
    assert_true(str_contains($stub, "\$t->index(['email', 'type'])"), 'the stub must index (email, type)');
    assert_true(str_contains($stub, "\$t->index(['token_hash', 'type'])"), 'the stub must index (token_hash, type)');

    \Widdx\Schema::create('auth_tokens', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('email');
        $t->string('type');
        $t->string('token_hash');
        $t->timestamp('created_at')->nullable();
    });
    db('auth_tokens')->insert([
        'email' => 'stale@widdx.test', 'type' => 'reset', 'token_hash' => 'deadbeef',
        'created_at' => date('Y-m-d H:i:s', time() - 60 * 60 * 24 * 30),
    ]);
    \Widdx\Auth::createToken('fresh@widdx.test', 'reset');
    assert_equals(0, db('auth_tokens')->where('email', 'stale@widdx.test')->count(), 'a 30-day-old token must be pruned when a new one is issued');
    assert_equals(1, db('auth_tokens')->where('email', 'fresh@widdx.test')->count(), 'the fresh token is still stored');
    db('auth_tokens')->where('email', 'fresh@widdx.test')->delete();
    \Widdx\Schema::dropIfExists('auth_tokens');

    // 5. CONFIG-01 — a config key no code reads is a setting that silently does nothing.
    assert_true(!array_key_exists('session_key', (array) config('auth')), 'auth.session_key promised nothing and is gone');
    $authCfg = (string) file_get_contents(__DIR__ . '/config/auth.php');
    assert_true(!str_contains($authCfg, "'session_key'"), 'config/auth.php must not offer an inert key');
});

/**
 * 2.24 the Inflector: the three English rules in the framework agree and are reversible.
 * Why this test exists: a table name is written by one of them (Model::pluralize through
 * inferTable(), MakeCrud::pluralize through make:crud) and read back by another (the global
 * singular(), which resource() uses to name the controller and model). When the rules differed,
 * `make:crud Guy` and the model itself disagreed about the table, and status/bus/news came back
 * as statu/bu/new — a 404 that points at nothing.
 */
test('2.24 Inflector: irregular plurals agree across the three call sites and round-trip', function () {
    $pluralize = static function (string $class, string $word): string {
        $m = (new \ReflectionMethod($class, 'pluralize'));
        $m->setAccessible(true);
        return (string) $m->invoke(null, $word);
    };

    // 1. singularization: the measured failures, plus every case the old rule already got right
    foreach ([
        'toys' => 'toy', 'guys' => 'guy', 'boys' => 'boy',           // vowel + y: never "toies"
        'status' => 'status', 'bus' => 'bus', 'news' => 'news',       // already singular in shape
        'buses' => 'bus', 'statuses' => 'status', 'boxes' => 'box',   // the -es plurals
        'posts' => 'post', 'categories' => 'category', 'addresses' => 'address', 'users' => 'user',
    ] as $plural => $want) {
        assert_equals($want, singular($plural), "singular('{$plural}')");
    }

    // 2. pluralization: both implementations must emit the same table name for the same model
    foreach (['toy', 'guy', 'boy', 'status', 'bus', 'news', 'series', 'category',
              'address', 'user', 'post', 'box', 'quiz'] as $word) {
        assert_equals(
            $pluralize(\Widdx\Model::class, $word),
            $pluralize(\Widdx\Cli\MakeCrud::class, $word),
            "Model::pluralize() and MakeCrud::pluralize() disagree about '{$word}'"
        );
    }

    // 3. the plural forms the docs teach, proved rather than asserted
    foreach ([
        'toy' => 'toys', 'guy' => 'guys', 'boy' => 'boys', 'post' => 'posts', 'user' => 'users',
        'category' => 'categories', 'address' => 'addresses', 'box' => 'boxes',
        'status' => 'statuses', 'bus' => 'buses', 'news' => 'news', 'series' => 'series',
    ] as $word => $want) {
        assert_equals($want, $pluralize(\Widdx\Model::class, $word), "pluralize('{$word}')");
    }

    // 4. round trip: model name → table → back to the model name, for every word above
    foreach (['toy', 'guy', 'boy', 'post', 'user', 'category', 'address', 'box',
              'status', 'bus', 'news', 'series'] as $word) {
        $table = $pluralize(\Widdx\Model::class, $word);
        assert_equals($word, singular($table), "round trip {$word} -> {$table} -> ?");
    }
});

test('2.25 DEPLOY-01 C: demo start stays public, --no-demo starts fail-closed, make:auth closes users, nothing seeds a password', function () {
    $php = escapeshellarg(PHP_BINARY);
    $fwCli = $php . ' ' . escapeshellarg(WIDDX_BASE_PATH . '/widdx');
    $root = sys_get_temp_dir() . '/widdx-deploy01-' . getmypid();
    @mkdir($root, 0775, true);

    $rrm = function (string $dir) use (&$rrm): void {
        foreach (scandir($dir) ?: [] as $f) {
            if ($f === '.' || $f === '..') {
                continue;
            }
            $p = $dir . '/' . $f;
            if (is_dir($p)) {
                $rrm($p);
            } else {
                @unlink($p);
            }
        }
        @rmdir($dir);
    };

    // The CI matrix exports DB_CONNECTION=mysql/pgsql AND DB_DATABASE=widdx for the whole job;
    // the scaffold's own promise is zero-config sqlite, and this gate is about what a freshly
    // generated project does — so pin both keys, or the project would open a file named "widdx".
    $run = static function (string $cwd, string $cmd) use ($php): array {
        $out = [];
        $code = 0;
        exec('cd ' . escapeshellarg($cwd)
            . ' && DB_CONNECTION=sqlite DB_DATABASE=' . escapeshellarg($cwd . '/database.sqlite')
            . ' ' . $cmd . ' 2>&1', $out, $code);
        return [$code, implode("\n", $out)];
    };

    // The decision a guest is actually given comes from Route::isPublic() (GatesCrudActions
    // reads it, Router::currentRouteIsPublic() carries it), so read it off the routes the
    // generated file registers rather than off the text of that file.
    $usersPublicFlags = static function (string $file): array {
        \Widdx\Router::reset();
        require $file;
        $flags = [];
        foreach (\Widdx\Router::getInstance()->all() as $r) {
            if ($r->uri === '/users' || str_starts_with($r->uri, '/users/')) {
                $flags[] = $r->isPublic();
            }
        }
        \Widdx\Router::reset();
        return $flags;
    };

    try {
        // 1. both scaffolds build, and PART 0's command order is the one that still works.
        [$demoNew, $demoNewOut] = $run($root, $fwCli . ' new demo');
        assert_equals(0, $demoNew, 'php widdx new demo exits 0: ' . $demoNewOut);
        [$ndNew, $ndNewOut] = $run($root, $fwCli . ' new app --no-demo');
        assert_equals(0, $ndNew, 'php widdx new app --no-demo exits 0: ' . $ndNewOut);
        $demo = $root . '/demo';
        $nodemo = $root . '/app';

        // 2. the two routes files differ in exactly one thing: the users opt-out.
        $demoRoutes = (string) file_get_contents($demo . '/routes/web.php');
        $ndRoutes = (string) file_get_contents($nodemo . '/routes/web.php');
        assert_true(str_contains($demoRoutes, "resource('users')->public();"), 'demo scaffold keeps the public users CRUD');
        assert_true(str_contains($ndRoutes, "resource('users');"), '--no-demo scaffold emits the users resource');
        // Comment lines explain ->public(); only a line that starts with code may call it.
        assert_true(preg_match('/^[^\/\n]*->public\(\)/m', $ndRoutes) === 0, '--no-demo scaffold has no public() call');

        // 3. generated projects still parse and migrate (and the table really is there).
        foreach ([['demo', $demo], ['--no-demo', $nodemo]] as [$label, $proj]) {
            [$lint, $lintOut] = $run($proj, $php . ' -l routes/web.php');
            assert_equals(0, $lint, "{$label} routes/web.php parses: " . $lintOut);
            [$mig, $migOut] = $run($proj, $php . ' widdx migrate');
            assert_equals(0, $mig, "{$label} php widdx migrate exits 0: " . $migOut);
            assert_true(is_file($proj . '/database.sqlite'), "{$label} migrate created database.sqlite");
        }

        // 4. guest access: demo is open, --no-demo is fail-closed on all seven routes.
        $demoFlags = $usersPublicFlags($demo . '/routes/web.php');
        assert_equals(7, count($demoFlags), 'demo users resource registers 7 routes');
        assert_true(count($demoFlags) > 0 && !in_array(false, $demoFlags, true), 'every demo users route is public');
        $ndFlags = $usersPublicFlags($nodemo . '/routes/web.php');
        assert_equals(7, count($ndFlags), '--no-demo users resource registers 7 routes');
        assert_true(count($ndFlags) > 0 && !in_array(true, $ndFlags, true), 'no --no-demo users route is public — guests go to /login');

        // 5. no usable credential is seeded: the seeder never hashes one, and no row carries one.
        [$seed, $seedOut] = $run($demo, $php . ' widdx db:seed');
        assert_equals(0, $seed, 'demo php widdx db:seed exits 0: ' . $seedOut);
        $seederSrc = (string) file_get_contents($demo . '/database/seeders/UserSeeder.php');
        assert_true(!str_contains($seederSrc, 'password_hash'), 'the scaffolded seeder hashes no password');
        assert_true(str_contains($seederSrc, 'INSERT INTO users (name, email)'), 'the scaffolded seeder inserts no password column');
        $pdo = new \PDO('sqlite:' . $demo . '/database.sqlite');
        $rows = $pdo->query('SELECT name, email, password FROM users')->fetchAll(\PDO::FETCH_ASSOC);
        assert_true(count($rows) >= 3, 'the demo still has rows to list: ' . count($rows));
        foreach ($rows as $row) {
            assert_true($row['password'] === null, 'seeded user ' . $row['email'] . ' has no password to log in with');
        }

        // 6. make:auth withdraws the demo opt-out for the users resource only.
        file_put_contents($demo . '/routes/web.php', "\nresource('posts')->public();\n", FILE_APPEND);
        [$auth, $authOut] = $run($demo, $php . ' widdx make:auth');
        assert_equals(0, $auth, 'demo php widdx make:auth exits 0: ' . $authOut);
        $afterAuth = (string) file_get_contents($demo . '/routes/web.php');
        assert_true(!str_contains($afterAuth, "resource('users')->public()"), 'make:auth removed ->public() from the users resource');
        assert_true(str_contains($afterAuth, "resource('users');"), 'make:auth kept the users resource itself');
        assert_true(str_contains($afterAuth, 'authRoutes();'), 'make:auth still adds authRoutes()');
        assert_true(str_contains($afterAuth, "resource('posts')->public();"), 'make:auth left every other ->public() alone');
    } finally {
        $rrm($root);
    }
});

