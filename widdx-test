    echo "{$status} {$t['name']}\n";
    if (isset($t['error'])) {
        echo "   Error: {$t['error']}\n";
    }
}

echo "\n";
echo str_repeat('=', 60) . "\n";
echo "Total: " . count($tests) . " | Passed: {$passed} | Failed: {$failed}\n";
echo str_repeat('=', 60) . "\n";

exit($failed > 0 ? 1 : 0);
