    $mail = new \Widdx\LogMail();
    \Widdx\Mail::setConnection($mail);
    \Widdx\Auth::useModel(\Widdx\Tests\AuthUser::class);

    $user = \Widdx\Auth::register([
        'name' => 'Sara', 'email' => 'sara@widdx.test',
        'password' => 'supersecret1', 'password_confirmation' => 'supersecret1',
    ], false);
    assert_true(!empty($user->id), 'registered');
    assert_true(str_starts_with((string) $user->password, '$2y$'), 'password hashed');

    // verification mail went out automatically (column exists)
    $body = (string) ($mail->logged()[0]['body'] ?? '');
    preg_match('#/verify-email/([a-f0-9]{64})\?email=#', $body, $m);
    assert_true(!empty($m[1]), 'verify token present in mail body');
    assert_equals(false, \Widdx\Auth::verifyEmail('sara@widdx.test', 'deadbeef'), 'wrong token rejected');
    assert_true(\Widdx\Auth::verifyEmail('sara@widdx.test', $m[1]), 'valid token verifies');
    assert_true(!empty(\Widdx\Tests\AuthUser::find($user->id)->email_verified_at), 'flag stored');

    // password reset: unknown email → false; known → mailed token link
    assert_equals(false, \Widdx\Auth::sendResetLink('ghost@nowhere.test'));
    assert_true(\Widdx\Auth::sendResetLink('sara@widdx.test'));
    // 1.9: reset mail is deferred to Event::flush (post-response) on purpose.
    \Widdx\Event::flush();
    $resetBody = (string) ($mail->logged()[1]['body'] ?? '');
