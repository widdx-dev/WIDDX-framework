#!/usr/bin/env php
<?php

declare(strict_types=1);

// Widdx test runner: php widdx test

define('WIDDX_BASE_PATH', __DIR__);

$autoload = __DIR__ . '/vendor/autoload.php';
if (is_file($autoload)) {
    require $autoload;
} else {
    spl_autoload_register(function ($class) {
        $prefixes = [
            'Widdx\\Tests\\' => __DIR__ . '/tests/',
            'Widdx\\' => __DIR__ . '/core/',
            'App\\' => __DIR__ . '/app/',
            'Psr\\' => __DIR__ . '/polyfill/', // offline stand-in for psr/container
        ];
        foreach ($prefixes as $prefix => $dir) {
            if (str_starts_with($class, $prefix)) {
                $file = $dir . str_replace('\\', '/', substr($class, strlen($prefix))) . '.php';
                if (is_file($file)) {
                    require $file;
                }
            }
        }
    });
    require __DIR__ . '/core/helpers.php';
}

// 2.7: honour the environment so the suite can run against sqlite/mysql/pgsql
// (CI matrix + local: DB_CONNECTION=pgsql php widdx-test). loadEnv never
// overrides real env vars, so with no .env this is a config-only boot.
\Widdx\App::basePath(WIDDX_BASE_PATH);
\Widdx\App::loadEnv(WIDDX_BASE_PATH);
\Widdx\App::loadConfig(WIDDX_BASE_PATH . '/config');

// A missing PDO extension is an ENVIRONMENT failure, not a code failure. Without
// this it surfaces as a dozen "could not find driver" tests that look like bugs.
$driver = (string) config('database.default', 'sqlite');
$wantedExt = ['sqlite' => 'pdo_sqlite', 'mysql' => 'pdo_mysql', 'pgsql' => 'pdo_pgsql', 'sqlsrv' => 'pdo_sqlsrv', 'oci' => 'pdo_oci'][$driver] ?? null;
if ($wantedExt !== null && !extension_loaded($wantedExt)) {
    fwrite(STDERR, <<<TXT
        Widdx test suite cannot run: PHP driver '{$wantedExt}' is not installed.
          DB_CONNECTION={$driver} needs it. Fix (pick one):
            apt install php-sqlite3            (Debian/Ubuntu, SQLite)
            docker run a php image that has it (e.g. php:8.3-cli)
          Then re-run: php widdx-test

        TXT);
    exit(2);
}

// 2.7: the networked drivers outlive a single run — wipe the schema so
// leftover tables/rows (unique indexes, stale jobs) cannot poison a rerun.
function widdx_reset_networked_db(): void
{
    $drv = (string) (getenv('DB_CONNECTION') ?: 'sqlite');
    if (!in_array($drv, ['mysql', 'pgsql'], true)) {
        return;
    }
    $host = (string) (getenv('DB_HOST') ?: '127.0.0.1');
    $port = (int) (getenv('DB_PORT') ?: ($drv === 'mysql' ? 3306 : 5432));
    $user = (string) (getenv('DB_USERNAME') ?: ($drv === 'mysql' ? 'root' : 'postgres'));
    $pass = (string) (getenv('DB_PASSWORD') ?: ($drv === 'mysql' ? 'widdxpass' : ''));
    $name = (string) (getenv('DB_DATABASE') ?: 'widdx');
    if ($drv === 'mysql') {
        $pdo = new PDO("mysql:host={$host};port={$port}", $user, $pass, [PDO::ATTR_TIMEOUT => 5]);
        $pdo->exec("DROP DATABASE IF EXISTS {$name}");
        $pdo->exec("CREATE DATABASE {$name} CHARACTER SET utf8mb4");
        return;
    }
    // pgsql: connect to the TARGET database, not 'postgres', or the wipe
    // drops the wrong schema and stale rows survive a rerun.
    $pdo = new PDO("pgsql:host={$host};port={$port};dbname={$name}", $user, $pass, [PDO::ATTR_TIMEOUT => 5]);
    $pdo->exec("DROP SCHEMA IF EXISTS public CASCADE");
    $pdo->exec("CREATE SCHEMA public");
    $pdo->exec("GRANT ALL ON SCHEMA public TO {$user}");
}

widdx_reset_networked_db();

// Simple test runner
$tests = [];
$passed = 0;
$failed = 0;

function test(string $name, callable $fn): void
{
    global $tests, $passed, $failed;
    try {
        $fn();
        $tests[] = ['name' => $name, 'status' => 'PASS'];
        $passed++;
    } catch (\Throwable $e) {
        $tests[] = ['name' => $name, 'status' => 'FAIL', 'error' => $e->getMessage()];
        $failed++;
    }
}

function assert_true(bool $condition, string $message = ''): void
{
    if (!$condition) {
        throw new \RuntimeException($message ?: 'Assertion failed');
    }
}

function assert_equals(mixed $expected, mixed $actual, string $message = ''): void
{
    if ($expected !== $actual) {
        throw new \RuntimeException($message ?: "Expected " . var_export($expected, true) . ", got " . var_export($actual, true));
    }
}

