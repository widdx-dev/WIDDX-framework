// Shared-hosting web installer logic (no server needed — pure functions)
test('Installer: buildEnv + lock + requirements + testConnection', function () {
    $base = WIDDX_BASE_PATH . '/storage/app/unittest-inst';
    foreach (['storage/cache', 'storage/logs', 'storage/sessions'] as $d) {
        @mkdir($base . '/' . $d, 0777, true);
    }

    // buildEnv: only provided keys, quoting for awkward values
    $env = \Widdx\Installer::buildEnv([
        'DB_CONNECTION' => 'mysql', 'DB_HOST' => 'db.example.com', 'DB_PORT' => '',
        'DB_DATABASE' => 'app_db', 'DB_USERNAME' => 'user', 'DB_PASSWORD' => 'a b=c',
        'APP_DEBUG' => '1',
    ]);
    assert_true(str_contains($env, "DB_CONNECTION=mysql\n"));
    assert_true(str_contains($env, 'DB_HOST=db.example.com'));
    assert_true(!str_contains($env, 'DB_PORT='), 'empty values are skipped');
    assert_true(str_contains($env, 'DB_PASSWORD="a b=c"'), 'space/= must be quoted');
    assert_true(str_contains($env, 'APP_DEBUG=true'));

    // 1.10: CR/LF in a value would append rogue lines to .env — refuse hard.
    // (must be the server branch, since sqlite only writes DB_DATABASE)
    $threw = false;
    try {
        \Widdx\Installer::buildEnv(['DB_CONNECTION' => 'mysql', 'DB_HOST' => "evil.example.com\nAPP_DEBUG=true"]);
    } catch (\RuntimeException $e) {
        $threw = str_contains($e->getMessage(), 'REFUSED');
    }
    assert_true($threw, 'newline in a value must throw, never write');

    // 1.10: install key lifecycle — created once, 32 hex, proof-of-possession.
    $key = \Widdx\Installer::installKey($base);
    assert_true((bool) preg_match('/^[0-9a-f]{32}$/', $key), 'key shape');
    assert_equals($key, \Widdx\Installer::installKey($base), 'stable across calls');
    assert_equals(false, \Widdx\Installer::keyMatches($base, 'guess-guess-guess-guess-guess-1234'));
    assert_equals(false, \Widdx\Installer::keyMatches($base, ['array', 'input']));
    assert_true(\Widdx\Installer::keyMatches($base, $key), 'typed key matches');

    // sqlite connection test creates the file relative to base
    $err = \Widdx\Installer::testConnection($base, ['DB_CONNECTION' => 'sqlite', 'DB_DATABASE' => './t.sqlite']);
    assert_equals(null, $err, 'sqlite testConnection: ' . (string) $err);
    assert_true(is_file($base . '/t.sqlite'), 'sqlite file created under base');

    // unknown driver + missing pdo extension both surface as string errors
    assert_true(is_string(\Widdx\Installer::testConnection($base, ['DB_CONNECTION' => 'nope'])));
    $mysqlErr = \Widdx\Installer::testConnection($base, ['DB_CONNECTION' => 'mysql', 'DB_HOST' => '127.0.0.1', 'DB_PORT' => '1']);
    assert_true(is_string($mysqlErr), 'mysql failure must return a message');

    // lock lifecycle
    assert_true(!\Widdx\Installer::installed($base), 'not installed yet');
    assert_true(!\Widdx\Installer::configured($base), 'no .env yet');
    \Widdx\Installer::lock($base);
    assert_true(\Widdx\Installer::installed($base), 'lock makes it installed');

    // requirements checklist shape
    $req = \Widdx\Installer::requirements($base);
    assert_true(count($req) >= 5, 'five checks minimum');
    foreach ($req as $c) {
        assert_true(isset($c['label'], $c['hint']) && is_bool($c['ok']), 'check shape');
    }

    // cleanup (recursive, warning-safe)
    $rrm = function (string $dir) use (&$rrm): void {
        foreach (scandir($dir) ?: [] as $f) {
            if ($f === '.' || $f === '..') {
                continue;
            }
            $p = $dir . '/' . $f;
            if (is_dir($p)) {
                $rrm($p);
            } else {
                @unlink($p);
            }
        }
        @rmdir($dir);
    };
    $rrm($base);
});

test('validate() confirmed rule + custom messages', function () {
    \Widdx\App::basePath(WIDDX_BASE_PATH);
    $request = new \Widdx\Request([], ['password' => 'secret', 'password_confirmation' => 'different'], ['REQUEST_METHOD' => 'POST']);
    $threw = false;
    try {
        $request->validate(['password' => 'required|confirmed']);
    } catch (\Widdx\Exceptions\ValidationException $e) {
        $threw = true;
        assert_true(str_contains($e->errors['password'][0], 'confirmation does not match'));
    }
    assert_true($threw, 'confirmed mismatch must fail');

    $request2 = new \Widdx\Request([], ['token' => ''], ['REQUEST_METHOD' => 'POST']);
    try {
        $request2->validate(['token' => 'required'], ['token.required' => 'CUSTOM :field msg']);
        assert_true(false, 'required token should fail');
    } catch (\Widdx\Exceptions\ValidationException $e) {
        assert_equals('CUSTOM token msg', $e->errors['token'][0]);
    }
});

test('2.1 numeric-string min/max compares as number, not length', function () {
    \Widdx\App::basePath(WIDDX_BASE_PATH);
    // '25' with int|min:18 must PASS (used to fail on strlen('25') === 2).
    $ok = (new \Widdx\Request([], ['age' => '25'], ['REQUEST_METHOD' => 'POST']))->validate(['age' => 'required|int|min:18']);
    assert_equals('25', $ok['age']);
    // '5' with int|min:18 must fail as min.numeric ("at least 18"), not min.string.
    $msg = 'NO-FAIL';
    try { (new \Widdx\Request([], ['age' => '5'], ['REQUEST_METHOD' => 'POST']))->validate(['age' => 'required|int|min:18']); }
    catch (\Widdx\Exceptions\ValidationException $e) { $msg = $e->errors['age'][0]; }
    assert_true(str_contains($msg, 'at least 18'), 'numeric min message: ' . $msg);
    // max with a numeric string fails on VALUE, not length.
    $msg2 = 'NO-FAIL';
    try { (new \Widdx\Request([], ['n' => '2000'], ['REQUEST_METHOD' => 'POST']))->validate(['n' => 'required|numeric|max:1000']); }
    catch (\Widdx\Exceptions\ValidationException $e) { $msg2 = $e->errors['n'][0]; }
    assert_true(str_contains($msg2, 'exceed 1000'), 'numeric max message: ' . $msg2);
    // a plain string keeps length-based min.
    $msg3 = 'NO-FAIL';
    try { (new \Widdx\Request([], ['code' => 'AB'], ['REQUEST_METHOD' => 'POST']))->validate(['code' => 'required|string|min:3']); }
    catch (\Widdx\Exceptions\ValidationException $e) { $msg3 = $e->errors['code'][0]; }
    assert_true(str_contains($msg3, 'at least 3 characters'), 'string min stays length-based: ' . $msg3);
    // A string that PASSED the length check must not be re-read as a number —
    // measured in a real project: '100' under string|max:50 was rejected (3
    // characters, but 100 > 50), and '0001' under string|min:3 likewise.
    $req = fn(array $d) => new \Widdx\Request([], $d, ['REQUEST_METHOD' => 'POST']);
    $fails = function (\Widdx\Request $r, array $rules): bool {
        try { $r->validate($rules); return false; } catch (\Widdx\Exceptions\ValidationException $e) { return true; }
    };
    assert_true(!$fails($req(['p' => '100']), ['p' => 'required|string|max:50']), "'100' passes string|max:50 (3 chars)");
    assert_true(!$fails($req(['c' => '0001']), ['c' => 'required|string|min:3']), "'0001' passes string|min:3 (4 chars)");
    assert_true($fails($req(['p' => '1000000']), ['p' => 'required|string|max:6']), 'long digit string still fails on length');
    // size: and between: measure the SAME way — they used to read any digit string as
    // a number first, so '100' failed string|size:3 and a 10-character word passed
    // string|between:1,5 without a single check.
    assert_true(!$fails($req(['c' => '100']), ['c' => 'required|string|size:3']), "'100' passes string|size:3 (3 chars)");
    assert_true($fails($req(['c' => '100']), ['c' => 'required|string|size:4']), 'string|size counts characters');
    assert_true(!$fails($req(['n' => '100']), ['n' => 'required|numeric|size:100']), 'numeric|size still counts value');
    assert_true($fails($req(['t' => 'abcdefghij']), ['t' => 'required|string|between:1,5']), 'a 10-char word fails string|between:1,5 on length');
    assert_true(!$fails($req(['t' => 'abcd']), ['t' => 'required|string|between:1,5']), 'a 4-char word passes string|between:1,5');
    assert_true($fails($req(['n' => '50']), ['n' => 'required|numeric|between:1,10']), 'numeric|between still compares by value');
});

test('2.2 unknown rule throws WiddxException; new rules validate', function () {
    \Widdx\App::basePath(WIDDX_BASE_PATH);
    // typo 'emial' must throw WiddxException instead of silently passing.
    $threw = false;
    try { (new \Widdx\Request([], ['x' => 'a@b.com'], ['REQUEST_METHOD' => 'POST']))->validate(['x' => 'required|emial']); }
    catch (\Widdx\Exceptions\WiddxException $e) { $threw = str_contains($e->getMessage(), 'Unknown validation rule [emial]'); }
    assert_true($threw, 'unknown rule must throw, not pass silently');

    $req = fn(array $d) => new \Widdx\Request([], $d, ['REQUEST_METHOD' => 'POST']);
    $fails = function (\Widdx\Request $r, array $rules): bool {
        try { $r->validate($rules); return false; } catch (\Widdx\Exceptions\ValidationException $e) { return true; }
    };
    // nullable is a recognized no-op; empty passes without throwing.
    $req(['nickname' => ''])->validate(['nickname' => 'nullable|alpha']);
    // date
    $req(['d' => '2024-01-31'])->validate(['d' => 'required|date']);
    assert_true($fails($req(['d' => 'so-not-a-date']), ['d' => 'required|date']), 'bad date must fail');
    // alpha / alpha_num
    $req(['a' => 'Hello World'])->validate(['a' => 'required|alpha']);
    assert_true($fails($req(['a' => 'Hello1']), ['a' => 'required|alpha']), 'alpha rejects digits');
    $req(['a' => 'Room214'])->validate(['a' => 'required|alpha_num']);
    assert_true($fails($req(['a' => 'Room 214']), ['a' => 'required|alpha_num']), 'alpha_num rejects spaces');
    // digits:5
    $req(['z' => '12345'])->validate(['z' => 'required|digits:5']);
    assert_true($fails($req(['z' => '1234']), ['z' => 'required|digits:5']), 'digits:5 rejects 4');
    // json
    $req(['j' => '{"a":1}'])->validate(['j' => 'required|json']);
    assert_true($fails($req(['j' => '{oops']), ['j' => 'required|json']), 'bad json fails');
    // starts_with / ends_with
    $req(['s' => 'Widdx rules'])->validate(['s' => 'required|starts_with:Widdx|ends_with:rules']);
    // size (exact string length)
    $req(['t' => 'abcde'])->validate(['t' => 'required|size:5']);
    assert_true($fails($req(['t' => 'abcd']), ['t' => 'required|size:5']), 'size:5 rejects 4');
    // between (numeric range)
    $req(['n' => '5'])->validate(['n' => 'required|numeric|between:1,10']);
    assert_true($fails($req(['n' => '50']), ['n' => 'required|numeric|between:1,10']), 'between rejects 50');
    // regex
    $req(['r' => 'AB-123'])->validate(['r' => 'required|regex:/^[A-Z]{2}-\d{3}$/']);
    assert_true($fails($req(['r' => 'abc']), ['r' => 'required|regex:/^[A-Z]{2}-\d{3}$/']), 'regex rejects lowercase');
    // boolean alias already worked
    $req(['b' => '1'])->validate(['b' => 'required|boolean']);
});

test('2.3 Request parses JSON/urlencoded bodies; json()/header()/bearerToken()', function () {
    \Widdx\App::basePath(WIDDX_BASE_PATH);
    // JSON body merged into input()/all()/validate().
    $r = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'POST', 'CONTENT_TYPE' => 'application/json']);
    $r->raw = '{"name":"Ada","age":30,"tags":["x","y"]}';
    $r->parseRawBody();
    assert_equals('Ada', $r->input('name'));
    assert_equals(30, $r->json('age'));
    assert_equals(['name' => 'Ada'], $r->validate(['name' => 'required|string']));
    // urlencoded PUT body (PHP would NOT fill $_POST for PUT).
    $p = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'PUT', 'CONTENT_TYPE' => 'application/x-www-form-urlencoded']);
    $p->raw = 'title=Hello+World&status=on';
    $p->parseRawBody();
    assert_equals('Hello World', $p->input('title'));
    // malformed JSON is flagged, never silently treated as empty.
    $b = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'POST', 'CONTENT_TYPE' => 'application/json']);
    $b->raw = '{not valid json';
    $b->parseRawBody();
    assert_true($b->malformedJson, 'bad json must set malformedJson');
    // bearer + header accessors.
    $h = new \Widdx\Request([], [], ['HTTP_AUTHORIZATION' => 'Bearer tok-123', 'HTTP_X_CUSTOM' => 'cv']);
    assert_equals('tok-123', $h->bearerToken());
    assert_equals('Bearer tok-123', $h->header('Authorization'));
    assert_equals('cv', $h->header('X-Custom'));
    assert_equals(null, $h->header('X-Missing'));
    assert_equals(null, (new \Widdx\Request())->bearerToken());
});

