    $pdo->exec('DELETE FROM leaks');

    // empty $fillable = NOTHING mass-assignable → create() must fail loudly
    $threw = false;
    try {
        \Widdx\Tests\Leak::create(['name' => 'x', 'is_admin' => 1, 'id' => 77]);
    } catch (\Widdx\Exceptions\ModelException $e) {
        $threw = true;
        assert_true(str_contains(strtolower($e->getMessage()), 'fillable'), 'exception must mention $fillable: ' . $e->getMessage());
    }
    assert_true($threw, 'empty $fillable must block create entirely');

    // explicit '*' opt-in works — but the primary key stays never-assignable
    $m = \Widdx\Tests\Open::create(['name' => 'ok', 'is_admin' => 1, 'id' => 77]);
    assert_equals('ok', $m->name);
    assert_equals(1, (int) $m->is_admin, '* allows listed-by-anything columns');
    assert_true((int) $m->id !== 77, 'primary key must never be mass-assignable');

    // allowlist model: unknown keys filtered, id ignored by fill()
    \Widdx\Schema::create('teams', function (\Widdx\Blueprint $t) {
        $t->id();
        $t->string('name');
    });
    $pdo->exec('DELETE FROM teams');
    $t = \Widdx\Tests\Team::create(['name' => 'T', 'is_admin' => 1]);
    assert_equals('T', $t->name);
    $t->fill(['name' => 'T2', 'id' => 999]);
    $t->save();
    $fresh = \Widdx\Tests\Team::find($t->id);
    assert_equals('T2', $fresh->name);
    assert_true((int) $fresh->id !== 999, 'fill() must ignore the primary key');

