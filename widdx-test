test('2.10 Throttle is a fixed window keyed on the route pattern', function () {
    $mw = new \Widdx\ThrottleMiddleware(2, 60);
    $next = fn () => \Widdx\Response::make('ok');
    $ip = '203.0.113.' . (string) random_int(20, 240);
    $mk = function (string $id) use ($ip) {
        $r = new \Widdx\Request([], [], ['REQUEST_METHOD' => 'GET', 'REQUEST_URI' => '/users/' . $id, 'REMOTE_ADDR' => $ip]);
        $r->routePattern = '/users/{id}';
        return $r;
    };
    // distinct URIs (/users/1, /users/2, /users/3) but the SAME pattern: only a
    // pattern key throttles them together (a raw-URI key would not).
    assert_equals(200, (int) $mw->handle($mk('1'), $next)->getStatus());
    assert_equals(200, (int) $mw->handle($mk('2'), $next)->getStatus());
    $resp = $mw->handle($mk('3'), $next);
    assert_equals(429, (int) $resp->getStatus(), 'third hit past the cap must 429 across ids (same pattern)');
    $ra = (int) ($resp->getHeaders()['Retry-After'] ?? 0);
    assert_true($ra >= 1 && $ra <= 60, 'Retry-After must be the real remaining time, got ' . $ra);
});

