    foreach (['app/Models/Post.php', 'app/Controllers/PostController.php', 'app/Middleware/',
              'app/Policies/PostPolicy.php', 'app/Jobs/', 'views/partials/', 'views/layouts/app.php',
              'database/migrations/', 'database/seeders/', 'routes/web.php', 'routes/console.php',
              'lang/<locale>.php', 'public/assets/', 'config/*.php'] as $path) {
