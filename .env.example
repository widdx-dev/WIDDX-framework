# Copy this file to .env and adjust for your environment:
# cp .env.example .env

# Default driver: sqlite | mysql | pgsql | sqlsrv | oci
DB_CONNECTION=sqlite

# sqlite: file path (auto-created) or :memory: for testing.
# A relative value is resolved against THIS project folder, not the current
# directory, so cron and a web server with any CWD still open this same file.
DB_DATABASE=./database.sqlite

# mysql / pgsql / sqlsrv / oci:
DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=widdx
#DB_USERNAME=root
#DB_PASSWORD=secret

# Oracle: service name (like XE or ORCLPDB1)
#DB_SERVICE=XE

# Application
# APP_DEBUG defaults to FALSE (safe for production). Uncomment ONLY on a
# local machine — it prints stack traces and technical error pages.
#APP_DEBUG=true
#APP_LOCALE=en        # framework messages: lang/{locale}.php (en is fallback)
#APP_URL=http://localhost:8000

# Mail — driver: log | smtp
#MAIL_DRIVER=log
#MAIL_FROM=noreply@example.com
#MAIL_FROM_NAME=Widdx
# SMTP only (leave MAIL_HOST empty to fall back to PHP mail()):
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_ENCRYPTION=tls   # '' = plain | tls = STARTTLS | ssl = implicit (465)
#MAIL_TIMEOUT=30
#MAIL_VERIFY_PEER=true

# Security headers (\Widdx\SecurityHeaders middleware)
#SECURITY_FRAME_OPTIONS=SAMEORIGIN
#SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
#SECURITY_CSP=
# Proxy IPs allowed to set X-Forwarded-For (or '*' behind a single edge proxy)
#TRUSTED_PROXIES=127.0.0.1
